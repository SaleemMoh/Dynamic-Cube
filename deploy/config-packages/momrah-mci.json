    {
      "entityType": "integ.connection",
      "entityCode": "MOMRAH_GATEWAY",
      "operation": "CREATE",
      "payload": {
        "nameAr": "بوابة خدمات الوزارة",
        "nameEn": "MoMRAH API gateway",
        "providerCode": "MCI",
        "baseUrl": "http://localhost:5090",
        "authType": "OAUTH2_CLIENT_CREDENTIALS",
        "secretName": "MOMRAH_GATEWAY",
        "tokenUrl": "/oauth/v1/token",
        "timeoutSeconds": 30,
        "retryCount": 2,
        "circuitBreakerFailures": 5,
        "circuitBreakerSeconds": 60,
        "headers": []
      }
    },
    {
      "entityType": "integ.envelope-profile",
      "entityCode": "MOMRAH",
      "operation": "CREATE",
      "payload": {
        "nameAr": "استجابة بوابة الوزارة",
        "nameEn": "MoMRAH gateway envelope",
        "statusCodePath": "statusDetails.code",
        "statusMessagePath": "statusDetails.message",
        "successStatusCodes": [
          "200"
        ],
        "businessCodePath": "data.responseCode",
        "businessMessagePath": "data.responseMessage",
        "successBusinessCodes": [
          "1"
        ],
        "resultPath": "data.result",
        "responseCodes": []
      }
    },
    {
      "entityType": "integ.operation",
      "entityCode": "MCI_CR_BY_ID_NUMBER",
      "operation": "CREATE",
      "payload": {
        "nameAr": "السجلات التجارية بدلالة رقم الهوية",
        "nameEn": "Commercial registrations by ID number",
        "connectionCode": "MOMRAH_GATEWAY",
        "envelopeProfileCode": "MOMRAH",
        "method": "GET",
        "pathTemplate": "/v1/MCI-DIP/cr-information-id-number/{idNumber}",
        "parameters": [
          {
            "name": "idNumber",
            "location": "PATH",
            "isRequired": true,
            "isMasked": true,
            "sampleValue": "1000000001"
          }
        ],
        "outputs": [
          {
            "name": "crNumbers",
            "path": "Licenses[*].Commercial_NO"
          },
          {
            "name": "crNames",
            "path": "Licenses[*].Commercial_Name"
          }
        ],
        "responseCodes": [
          {
            "code": "001-000001",
            "outcome": "NOT_FOUND",
            "messageAr": "لا توجد سجلات تجارية مطابقة.",
            "messageEn": "No matching commercial registration was found."
          },
          {
            "code": "001-000003",
            "outcome": "BUSINESS_ERROR",
            "messageAr": "يوجد سجل تجاري منتهي الصلاحية.",
            "messageEn": "At least one commercial registration has expired."
          },
          {
            "code": "001-000004",
            "outcome": "BUSINESS_ERROR",
            "messageAr": "يوجد سجل تجاري موقوف.",
            "messageEn": "At least one commercial registration is suspended."
          },
          {
            "code": "001-000006",
            "outcome": "TECHNICAL_ERROR",
            "messageAr": "الجهة غير مصرح لها بالخدمة لدى وزارة التجارة.",
            "messageEn": "The entity is not authorized for this Ministry of Commerce service."
          },
          {
            "code": "001-000007",
            "outcome": "BUSINESS_ERROR",
            "messageAr": "نوع الهوية غير صحيح.",
            "messageEn": "The ID type is not valid."
          },
          {
            "code": "001-000008",
            "outcome": "BUSINESS_ERROR",
            "messageAr": "رقم الهوية غير صحيح.",
            "messageEn": "The ID number is not valid."
          }
        ],
        "maskFields": [],
        "cacheSeconds": 0,
        "isIdempotent": true
      }
    },
