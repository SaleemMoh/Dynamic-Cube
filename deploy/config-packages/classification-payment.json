{
  "title": "Classification — paid service levels",
  "items": [
    {
      "entityType": "wf.workflow-version",
      "entityCode": "CLASSIFICATION_NEW/4",
      "operation": "CREATE",
      "payload": {
        "nameAr": "الإصدار 4 — سداد رسوم المسار المميز والماسي قبل المعالجة",
        "nameEn": "Version 4 — Premium and Diamond fees paid before processing",
        "definition": {
          "nodes": [
            {
              "code": "START",
              "type": "START",
              "nameAr": "تقديم الطلب",
              "nameEn": "Submitted",
              "next": "PAY"
            },
            {
              "code": "PAY",
              "type": "PAYMENT",
              "nameAr": "سداد رسوم مستوى الخدمة",
              "nameEn": "Pay the service level fee",
              "provider": "SADAD",
              "displayStatus": "AWAITING_PAYMENT",
              "next": "DISTRIBUTE",
              "expired": "UNPAID"
            },
            {
              "code": "DISTRIBUTE",
              "type": "HUMAN_TASK",
              "nameAr": "مراجعة الطلب وتوزيعه",
              "nameEn": "Review and distribute",
              "assignment": {
                "target": "ROLE",
                "role": "CLS_REQUEST_MANAGER",
                "mode": "QUEUE"
              },
              "sla": {
                "byLevel": {
                  "REGULAR": 2,
                  "PREMIUM": 1,
                  "DIAMOND": 1
                }
              },
              "actions": [
                {
                  "code": "DISTRIBUTE",
                  "kind": "COMPLETE",
                  "nameAr": "إحالة للتحليل",
                  "nameEn": "Send for analysis",
                  "to": "SPLIT"
                },
                {
                  "code": "RETURN",
                  "kind": "RETURN",
                  "nameAr": "طلب استكمال من مقدم الطلب",
                  "nameEn": "Ask the applicant for corrections"
                },
                {
                  "code": "REJECT",
                  "kind": "REJECT",
                  "nameAr": "رفض الطلب",
                  "nameEn": "Reject the request",
                  "to": "REJECTED"
                }
              ]
            },
            {
              "code": "SPLIT",
              "type": "PARALLEL_SPLIT",
              "nameAr": "التحليل المتوازي",
              "nameEn": "Parallel analysis",
              "branches": [
                "GOV_ANALYSIS",
                "PROJECTS_ANALYSIS",
                "FIN_ANALYSIS"
              ]
            },
            {
              "code": "GOV_ANALYSIS",
              "type": "HUMAN_TASK",
              "nameAr": "تحليل الحوكمة",
              "nameEn": "Governance analysis",
              "assignment": {
                "target": "PREVIOUS_ACTOR",
                "step": "GOV_ANALYSIS",
                "role": "CLS_GOV_ANALYST",
                "mode": "DISTRIBUTE",
                "distributorRole": "CLS_REQUEST_MANAGER"
              },
              "sla": {
                "byLevel": {
                  "REGULAR": 15,
                  "PREMIUM": 8,
                  "DIAMOND": 2
                },
                "escalateToRole": "CLS_REQUEST_MANAGER"
              },
              "actions": [
                {
                  "code": "SEND_TO_AUDIT",
                  "kind": "COMPLETE",
                  "nameAr": "رفع للتدقيق",
                  "nameEn": "Send for audit",
                  "to": "GOV_AUDIT"
                },
                {
                  "code": "RETURN",
                  "kind": "RETURN",
                  "nameAr": "طلب استكمال من مقدم الطلب",
                  "nameEn": "Ask the applicant for corrections"
                }
              ]
            },
            {
              "code": "GOV_AUDIT",
              "type": "HUMAN_TASK",
              "nameAr": "تدقيق الحوكمة",
              "nameEn": "Governance audit",
              "excludeActorsOf": [
                "GOV_ANALYSIS"
              ],
              "assignment": {
                "target": "ROLE",
                "role": "CLS_GOV_AUDITOR",
                "mode": "QUEUE"
              },
              "sla": {
                "byLevel": {
                  "REGULAR": 5,
                  "PREMIUM": 3,
                  "DIAMOND": 1
                },
                "escalateToRole": "CLS_REQUEST_MANAGER"
              },
              "actions": [
                {
                  "code": "CONFIRM",
                  "kind": "COMPLETE",
                  "nameAr": "اعتماد التحليل",
                  "nameEn": "Confirm the analysis",
                  "to": "JOIN"
                },
                {
                  "code": "BACK_TO_ANALYST",
                  "kind": "COMPLETE",
                  "nameAr": "إعادة للمحلل",
                  "nameEn": "Back to the analyst",
                  "to": "GOV_ANALYSIS",
                  "commentRequired": true
                }
              ]
            },
            {
              "code": "PROJECTS_ANALYSIS",
              "type": "HUMAN_TASK",
              "nameAr": "تحليل المشاريع والخبرات",
              "nameEn": "Projects & experience analysis",
              "assignment": {
                "target": "PREVIOUS_ACTOR",
                "step": "PROJECTS_ANALYSIS",
                "role": "CLS_PROJECTS_ANALYST",
                "mode": "DISTRIBUTE",
                "distributorRole": "CLS_REQUEST_MANAGER"
              },
              "sla": {
                "byLevel": {
                  "REGULAR": 15,
                  "PREMIUM": 8,
                  "DIAMOND": 2
                },
                "escalateToRole": "CLS_REQUEST_MANAGER"
              },
              "actions": [
                {
                  "code": "SEND_TO_AUDIT",
                  "kind": "COMPLETE",
                  "nameAr": "رفع للتدقيق",
                  "nameEn": "Send for audit",
                  "to": "PROJECTS_AUDIT"
                },
                {
                  "code": "RETURN",
                  "kind": "RETURN",
                  "nameAr": "طلب استكمال من مقدم الطلب",
                  "nameEn": "Ask the applicant for corrections"
                }
              ]
            },
            {
              "code": "PROJECTS_AUDIT",
              "type": "HUMAN_TASK",
              "nameAr": "تدقيق المشاريع",
              "nameEn": "Projects audit",
              "excludeActorsOf": [
                "PROJECTS_ANALYSIS"
              ],
              "assignment": {
                "target": "ROLE",
                "role": "CLS_PROJECTS_AUDITOR",
                "mode": "QUEUE"
              },
              "sla": {
                "byLevel": {
                  "REGULAR": 5,
                  "PREMIUM": 3,
                  "DIAMOND": 1
                },
                "escalateToRole": "CLS_REQUEST_MANAGER"
              },
              "actions": [
                {
                  "code": "CONFIRM",
                  "kind": "COMPLETE",
                  "nameAr": "اعتماد التحليل",
                  "nameEn": "Confirm the analysis",
                  "to": "JOIN"
                },
                {
                  "code": "BACK_TO_ANALYST",
                  "kind": "COMPLETE",
                  "nameAr": "إعادة للمحلل",
                  "nameEn": "Back to the analyst",
                  "to": "PROJECTS_ANALYSIS",
                  "commentRequired": true
                }
              ]
            },
            {
              "code": "FIN_ANALYSIS",
              "type": "HUMAN_TASK",
              "nameAr": "تحليل المالي",
              "nameEn": "Financial analysis",
              "assignment": {
                "target": "PREVIOUS_ACTOR",
                "step": "FIN_ANALYSIS",
                "role": "CLS_FIN_ANALYST",
                "mode": "DISTRIBUTE",
                "distributorRole": "CLS_REQUEST_MANAGER"
              },
              "sla": {
                "byLevel": {
                  "REGULAR": 15,
                  "PREMIUM": 8,
                  "DIAMOND": 2
                },
                "escalateToRole": "CLS_REQUEST_MANAGER"
              },
              "actions": [
                {
                  "code": "SEND_TO_AUDIT",
                  "kind": "COMPLETE",
                  "nameAr": "رفع للتدقيق",
                  "nameEn": "Send for audit",
                  "to": "FIN_AUDIT"
                },
                {
                  "code": "RETURN",
                  "kind": "RETURN",
                  "nameAr": "طلب استكمال من مقدم الطلب",
                  "nameEn": "Ask the applicant for corrections"
                }
              ]
            },
            {
              "code": "FIN_AUDIT",
              "type": "HUMAN_TASK",
              "nameAr": "مراجعة مدير التدقيق",
              "nameEn": "Audit manager review",
              "excludeActorsOf": [
                "FIN_ANALYSIS"
              ],
              "assignment": {
                "target": "ROLE",
                "role": "CLS_AUDIT_MANAGER",
                "mode": "QUEUE"
              },
              "sla": {
                "byLevel": {
                  "REGULAR": 5,
                  "PREMIUM": 3,
                  "DIAMOND": 1
                },
                "escalateToRole": "CLS_REQUEST_MANAGER"
              },
              "actions": [
                {
                  "code": "CONFIRM",
                  "kind": "COMPLETE",
                  "nameAr": "اعتماد التحليل",
                  "nameEn": "Confirm the analysis",
                  "to": "JOIN"
                },
                {
                  "code": "BACK_TO_ANALYST",
                  "kind": "COMPLETE",
                  "nameAr": "إعادة للمحلل",
                  "nameEn": "Back to the analyst",
                  "to": "FIN_ANALYSIS",
                  "commentRequired": true
                }
              ]
            },
            {
              "code": "JOIN",
              "type": "JOIN",
              "nameAr": "اكتمال التحليل",
              "nameEn": "Analysis complete",
              "mode": "ALL",
              "next": "GRADE"
            },
            {
              "code": "GRADE",
              "type": "DECISION",
              "nameAr": "احتساب الدرجات",
              "nameEn": "Grade calculation",
              "ruleSet": "CLS_GRADING",
              "result": "grading",
              "input": {
                "sectors": {
                  "var": "data.CLS_SECTORS"
                },
                "employees": {
                  "var": "data.CLS_EMPLOYEES"
                },
                "saudis": {
                  "var": "data.CLS_SAUDI_EMPLOYEES"
                },
                "engineers": {
                  "var": "data.CLS_ENGINEERS"
                },
                "technicians": {
                  "var": "data.CLS_TECHNICIANS"
                },
                "dgaCategory": {
                  "var": "data.CLS_DGA_CATEGORY"
                },
                "projectsValue": {
                  "var": "data.CLS_PROJECTS_VALUE"
                },
                "largestProject": {
                  "var": "data.CLS_LARGEST_PROJECT"
                },
                "board": {
                  "var": "data.CLS_GOV_BOARD"
                },
                "erp": {
                  "var": "data.CLS_GOV_ERP"
                },
                "pms": {
                  "var": "data.CLS_GOV_PMS"
                },
                "org": {
                  "var": "data.CLS_GOV_ORG"
                },
                "iso": {
                  "var": "data.CLS_GOV_ISO"
                }
              },
              "next": "GM_APPROVAL"
            },
            {
              "code": "GM_APPROVAL",
              "type": "HUMAN_TASK",
              "nameAr": "اعتماد المدير العام",
              "nameEn": "General manager approval",
              "displayStatus": "PENDING_APPROVAL",
              "assignment": {
                "target": "ROLE",
                "role": "CLS_GENERAL_MANAGER",
                "mode": "QUEUE"
              },
              "sla": {
                "byLevel": {
                  "REGULAR": 5,
                  "PREMIUM": 3,
                  "DIAMOND": 1
                }
              },
              "actions": [
                {
                  "code": "APPROVE",
                  "kind": "APPROVE",
                  "nameAr": "اعتماد التصنيف",
                  "nameEn": "Approve the classification",
                  "to": "CLASSIFIED",
                  "commentToApplicant": true
                },
                {
                  "code": "REJECT",
                  "kind": "REJECT",
                  "nameAr": "رفض الطلب",
                  "nameEn": "Reject the request",
                  "to": "REJECTED"
                },
                {
                  "code": "RETURN",
                  "kind": "RETURN",
                  "nameAr": "طلب استكمال من مقدم الطلب",
                  "nameEn": "Ask the applicant for corrections"
                }
              ]
            },
            {
              "code": "CLASSIFIED",
              "type": "GATEWAY",
              "nameAr": "هل صُنّف قطاع؟",
              "nameEn": "Any sector classified?",
              "routes": [
                {
                  "when": {
                    "var": "decisions.grading.eligible"
                  },
                  "to": "CERTIFICATE"
                }
              ],
              "default": "NOT_CLASSIFIED"
            },
            {
              "code": "CERTIFICATE",
              "type": "DOCUMENT",
              "nameAr": "إصدار شهادة التصنيف",
              "nameEn": "Issue the classification certificate",
              "documentType": "CLS_CERTIFICATE",
              "data": {
                "sizeClass": {
                  "var": "decisions.grading.sizeClassNameAr"
                },
                "city": {
                  "var": "data.CLS_CR_CITY"
                },
                "requestNumber": {
                  "var": "number"
                }
              },
              "lines": {
                "source": {
                  "filter": [
                    {
                      "var": "decisions.grading.items"
                    },
                    {
                      "var": "classified"
                    }
                  ]
                },
                "as": "line",
                "fields": {
                  "sectorNameAr": {
                    "var": "line.sectorNameAr"
                  },
                  "sectorNameEn": {
                    "var": "line.sectorNameEn"
                  },
                  "grade": {
                    "var": "line.grade"
                  }
                }
              },
              "reason": "اعتماد طلب التصنيف",
              "next": "APPROVED"
            },
            {
              "code": "APPROVED",
              "type": "END",
              "nameAr": "معتمد",
              "nameEn": "Approved",
              "outcome": "APPROVED"
            },
            {
              "code": "REJECTED",
              "type": "END",
              "nameAr": "مرفوض",
              "nameEn": "Rejected",
              "outcome": "REJECTED"
            },
            {
              "code": "NOT_CLASSIFIED",
              "type": "END",
              "nameAr": "لم يُصنّف أي قطاع",
              "nameEn": "No sector classified",
              "outcome": "REJECTED"
            },
            {
              "code": "UNPAID",
              "type": "END",
              "nameAr": "إغلاق لعدم السداد",
              "nameEn": "Closed: not paid",
              "outcome": "CLOSED",
              "displayStatus": "CLOSED_UNPAID"
            }
          ]
        }
      }
    }
  ]
}
