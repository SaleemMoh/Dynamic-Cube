    {
      "entityType": "wf.workflow",
      "entityCode": "CLASSIFICATION",
      "operation": "CREATE",
      "payload": {
        "nameAr": "معالجة طلبات التصنيف",
        "nameEn": "Classification processing",
        "descriptionAr": "مدير الطلبات يوزع، ثلاثة مسارات تحليل وتدقيق متوازية بمبدأ الفصل بين المُعد والمدقق، ثم اعتماد المدير العام.",
        "descriptionEn": "The request manager distributes; three parallel analysis and audit branches with maker-checker; then the general manager approves."
      }
    },
    {
      "entityType": "wf.workflow-version",
      "entityCode": "CLASSIFICATION/1",
      "operation": "CREATE",
      "payload": {
        "nameAr": "الإصدار 1",
        "nameEn": "Version 1",
        "definition": {
          "nodes": [
            {
              "code": "START",
              "type": "START",
              "nameAr": "تقديم الطلب",
              "nameEn": "Submitted",
              "next": "DISTRIBUTE"
            },
            {
              "code": "DISTRIBUTE",
              "type": "HUMAN_TASK",
              "nameAr": "مراجعة الطلب وتوزيعه",
              "nameEn": "Review and distribute",
              "assignment": {
                "target": "ROLE",
                "role": "CLS_REQUEST_MANAGER",
                "mode": "QUEUE"
              },
              "sla": {
                "byLevel": {
                  "REGULAR": 2,
                  "PREMIUM": 1,
                  "DIAMOND": 1
                }
              },
              "actions": [
                {
                  "code": "DISTRIBUTE",
                  "kind": "COMPLETE",
                  "nameAr": "إحالة للتحليل",
                  "nameEn": "Send for analysis",
                  "to": "SPLIT"
                },
                {
                  "code": "RETURN",
                  "kind": "RETURN",
                  "nameAr": "طلب استكمال من مقدم الطلب",
                  "nameEn": "Ask the applicant for corrections"
                },
                {
                  "code": "REJECT",
                  "kind": "REJECT",
                  "nameAr": "رفض الطلب",
                  "nameEn": "Reject the request",
                  "to": "REJECTED"
                }
              ]
            },
            {
              "code": "SPLIT",
              "type": "PARALLEL_SPLIT",
              "nameAr": "التحليل المتوازي",
              "nameEn": "Parallel analysis",
              "branches": [
                "GOV_ANALYSIS",
                "PROJECTS_ANALYSIS",
                "FIN_ANALYSIS"
              ]
            },
            {
              "code": "GOV_ANALYSIS",
              "type": "HUMAN_TASK",
              "nameAr": "تحليل الحوكمة",
              "nameEn": "Governance analysis",
              "assignment": {
                "target": "PREVIOUS_ACTOR",
                "step": "GOV_ANALYSIS",
                "role": "CLS_GOV_ANALYST",
                "mode": "DISTRIBUTE",
                "distributorRole": "CLS_REQUEST_MANAGER"
              },
              "sla": {
                "byLevel": {
                  "REGULAR": 15,
                  "PREMIUM": 8,
                  "DIAMOND": 2
                },
                "escalateToRole": "CLS_REQUEST_MANAGER"
              },
              "actions": [
                {
                  "code": "SEND_TO_AUDIT",
                  "kind": "COMPLETE",
                  "nameAr": "رفع للتدقيق",
                  "nameEn": "Send for audit",
                  "to": "GOV_AUDIT"
                },
                {
                  "code": "RETURN",
                  "kind": "RETURN",
                  "nameAr": "طلب استكمال من مقدم الطلب",
                  "nameEn": "Ask the applicant for corrections"
                }
              ]
            },
            {
              "code": "GOV_AUDIT",
              "type": "HUMAN_TASK",
              "nameAr": "تدقيق الحوكمة",
              "nameEn": "Governance audit",
              "excludeActorsOf": [
                "GOV_ANALYSIS"
              ],
              "assignment": {
                "target": "ROLE",
                "role": "CLS_GOV_AUDITOR",
                "mode": "QUEUE"
              },
              "sla": {
                "byLevel": {
                  "REGULAR": 5,
                  "PREMIUM": 3,
                  "DIAMOND": 1
                },
                "escalateToRole": "CLS_REQUEST_MANAGER"
              },
              "actions": [
                {
                  "code": "CONFIRM",
                  "kind": "COMPLETE",
                  "nameAr": "اعتماد التحليل",
                  "nameEn": "Confirm the analysis",
                  "to": "JOIN"
                },
                {
                  "code": "BACK_TO_ANALYST",
                  "kind": "COMPLETE",
                  "nameAr": "إعادة للمحلل",
                  "nameEn": "Back to the analyst",
                  "to": "GOV_ANALYSIS",
                  "commentRequired": true
                }
              ]
            },
            {
              "code": "PROJECTS_ANALYSIS",
              "type": "HUMAN_TASK",
              "nameAr": "تحليل المشاريع والخبرات",
              "nameEn": "Projects & experience analysis",
              "assignment": {
                "target": "PREVIOUS_ACTOR",
                "step": "PROJECTS_ANALYSIS",
                "role": "CLS_PROJECTS_ANALYST",
                "mode": "DISTRIBUTE",
                "distributorRole": "CLS_REQUEST_MANAGER"
              },
              "sla": {
                "byLevel": {
                  "REGULAR": 15,
                  "PREMIUM": 8,
                  "DIAMOND": 2
                },
                "escalateToRole": "CLS_REQUEST_MANAGER"
              },
              "actions": [
                {
                  "code": "SEND_TO_AUDIT",
                  "kind": "COMPLETE",
                  "nameAr": "رفع للتدقيق",
                  "nameEn": "Send for audit",
                  "to": "PROJECTS_AUDIT"
                },
                {
                  "code": "RETURN",
                  "kind": "RETURN",
                  "nameAr": "طلب استكمال من مقدم الطلب",
                  "nameEn": "Ask the applicant for corrections"
                }
              ]
            },
            {
              "code": "PROJECTS_AUDIT",
              "type": "HUMAN_TASK",
              "nameAr": "تدقيق المشاريع",
              "nameEn": "Projects audit",
              "excludeActorsOf": [
                "PROJECTS_ANALYSIS"
              ],
              "assignment": {
                "target": "ROLE",
                "role": "CLS_PROJECTS_AUDITOR",
                "mode": "QUEUE"
              },
              "sla": {
                "byLevel": {
                  "REGULAR": 5,
                  "PREMIUM": 3,
                  "DIAMOND": 1
                },
                "escalateToRole": "CLS_REQUEST_MANAGER"
              },
              "actions": [
                {
                  "code": "CONFIRM",
                  "kind": "COMPLETE",
                  "nameAr": "اعتماد التحليل",
                  "nameEn": "Confirm the analysis",
                  "to": "JOIN"
                },
                {
                  "code": "BACK_TO_ANALYST",
                  "kind": "COMPLETE",
                  "nameAr": "إعادة للمحلل",
                  "nameEn": "Back to the analyst",
                  "to": "PROJECTS_ANALYSIS",
                  "commentRequired": true
                }
              ]
            },
            {
              "code": "FIN_ANALYSIS",
              "type": "HUMAN_TASK",
              "nameAr": "تحليل المالي",
              "nameEn": "Financial analysis",
              "assignment": {
                "target": "PREVIOUS_ACTOR",
                "step": "FIN_ANALYSIS",
                "role": "CLS_FIN_ANALYST",
                "mode": "DISTRIBUTE",
                "distributorRole": "CLS_REQUEST_MANAGER"
              },
              "sla": {
                "byLevel": {
                  "REGULAR": 15,
                  "PREMIUM": 8,
                  "DIAMOND": 2
                },
                "escalateToRole": "CLS_REQUEST_MANAGER"
              },
              "actions": [
                {
                  "code": "SEND_TO_AUDIT",
                  "kind": "COMPLETE",
                  "nameAr": "رفع للتدقيق",
                  "nameEn": "Send for audit",
                  "to": "FIN_AUDIT"
                },
                {
                  "code": "RETURN",
                  "kind": "RETURN",
                  "nameAr": "طلب استكمال من مقدم الطلب",
                  "nameEn": "Ask the applicant for corrections"
                }
              ]
            },
            {
              "code": "FIN_AUDIT",
              "type": "HUMAN_TASK",
              "nameAr": "مراجعة مدير التدقيق",
              "nameEn": "Audit manager review",
              "excludeActorsOf": [
                "FIN_ANALYSIS"
              ],
              "assignment": {
                "target": "ROLE",
                "role": "CLS_AUDIT_MANAGER",
                "mode": "QUEUE"
              },
              "sla": {
                "byLevel": {
                  "REGULAR": 5,
                  "PREMIUM": 3,
                  "DIAMOND": 1
                },
                "escalateToRole": "CLS_REQUEST_MANAGER"
              },
              "actions": [
                {
                  "code": "CONFIRM",
                  "kind": "COMPLETE",
                  "nameAr": "اعتماد التحليل",
                  "nameEn": "Confirm the analysis",
                  "to": "JOIN"
                },
                {
                  "code": "BACK_TO_ANALYST",
                  "kind": "COMPLETE",
                  "nameAr": "إعادة للمحلل",
                  "nameEn": "Back to the analyst",
                  "to": "FIN_ANALYSIS",
                  "commentRequired": true
                }
              ]
            },
            {
              "code": "JOIN",
              "type": "JOIN",
              "nameAr": "اكتمال التحليل",
              "nameEn": "Analysis complete",
              "mode": "ALL",
              "next": "GM_APPROVAL"
            },
            {
              "code": "GM_APPROVAL",
              "type": "HUMAN_TASK",
              "nameAr": "اعتماد المدير العام",
              "nameEn": "General manager approval",
              "displayStatus": "PENDING_APPROVAL",
              "assignment": {
                "target": "ROLE",
                "role": "CLS_GENERAL_MANAGER",
                "mode": "QUEUE"
              },
              "sla": {
                "byLevel": {
                  "REGULAR": 5,
                  "PREMIUM": 3,
                  "DIAMOND": 1
                }
              },
              "actions": [
                {
                  "code": "APPROVE",
                  "kind": "APPROVE",
                  "nameAr": "اعتماد التصنيف",
                  "nameEn": "Approve the classification",
                  "to": "APPROVED",
                  "commentToApplicant": true
                },
                {
                  "code": "REJECT",
                  "kind": "REJECT",
                  "nameAr": "رفض الطلب",
                  "nameEn": "Reject the request",
                  "to": "REJECTED"
                },
                {
                  "code": "RETURN",
                  "kind": "RETURN",
                  "nameAr": "طلب استكمال من مقدم الطلب",
                  "nameEn": "Ask the applicant for corrections"
                }
              ]
            },
            {
              "code": "APPROVED",
              "type": "END",
              "nameAr": "معتمد",
              "nameEn": "Approved",
              "outcome": "APPROVED"
            },
            {
              "code": "REJECTED",
              "type": "END",
              "nameAr": "مرفوض",
              "nameEn": "Rejected",
              "outcome": "REJECTED"
            }
          ]
        }
      }
    },
