    {
      "entityType": "com.template",
      "entityCode": "VIS_SCHEDULED",
      "operation": "CREATE",
      "payload": {
        "nameAr": "موعد الزيارة الميدانية",
        "nameEn": "Site visit date",
        "inAppTitleAr": "حُدد موعد زيارة ميدانية لطلبك {{ visit.subjectNumber }}",
        "inAppTitleEn": "A site visit was scheduled for request {{ visit.subjectNumber }}",
        "inAppBodyAr": "{{ visit.typeNameAr }} يوم {{ visit.scheduledOn }} الساعة {{ visit.scheduledTime }} في {{ visit.siteAddress }}. يرجى إتاحة الموقع.",
        "inAppBodyEn": "{{ visit.typeNameEn }} on {{ visit.scheduledOn }} at {{ visit.scheduledTime }}, {{ visit.siteAddress }}. Please make the site accessible.",
        "link": "/requests/{{ visit.subjectId }}",
        "emailSubjectAr": "حُدد موعد زيارة ميدانية لطلبك {{ visit.subjectNumber }}",
        "emailSubjectEn": "A site visit was scheduled for request {{ visit.subjectNumber }}",
        "emailBodyAr": "<p>{{ recipient.name }}،</p><p>{{ visit.typeNameAr }} يوم {{ visit.scheduledOn }} الساعة {{ visit.scheduledTime }} في {{ visit.siteAddress }}. يرجى إتاحة الموقع.</p><p>منصة الخدمات الإلكترونية</p>",
        "emailBodyEn": "<p>Dear {{ recipient.name }},</p><p>{{ visit.typeNameEn }} on {{ visit.scheduledOn }} at {{ visit.scheduledTime }}, {{ visit.siteAddress }}. Please make the site accessible.</p><p>e-Services platform</p>"
      }
    },
