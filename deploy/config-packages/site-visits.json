    {
      "entityType": "vis.visit-type",
      "entityCode": "SITE_INSPECTION",
      "operation": "CREATE",
      "payload": {
        "nameAr": "معاينة الموقع",
        "nameEn": "Site inspection",
        "mode": "FIELD",
        "descriptionAr": "يزور مفتشو الجهة الموقع ويسجلون النتيجة والصور وتوقيع ممثل المنشأة من تطبيق الزيارات.",
        "descriptionEn": "The entity's inspectors visit the site and record the result, photos and the representative's signature in the field app.",
        "outcomes": [
          {
            "code": "COMPLIANT",
            "nameAr": "مطابق",
            "nameEn": "Compliant",
            "kind": "PASS"
          },
          {
            "code": "NON_COMPLIANT",
            "nameAr": "غير مطابق",
            "nameEn": "Not compliant",
            "kind": "FAIL"
          },
          {
            "code": "NOT_ACCESSIBLE",
            "nameAr": "تعذّر الوصول إلى الموقع",
            "nameEn": "Site not accessible",
            "kind": "OTHER"
          }
        ],
        "fields": [
          {
            "code": "findings",
            "labelAr": "ملاحظات المعاينة",
            "labelEn": "Findings",
            "type": "TEXTAREA",
            "required": true,
            "options": []
          },
          {
            "code": "area",
            "labelAr": "المساحة المعاينة (م²)",
            "labelEn": "Area inspected (m²)",
            "type": "NUMBER",
            "required": false,
            "options": []
          },
          {
            "code": "signage",
            "labelAr": "اللوحة التعريفية",
            "labelEn": "Name board",
            "type": "SELECT",
            "required": true,
            "options": [
              {
                "code": "PRESENT",
                "labelAr": "موجودة ومطابقة",
                "labelEn": "Present and compliant"
              },
              {
                "code": "NON_COMPLIANT",
                "labelAr": "موجودة وغير مطابقة",
                "labelEn": "Present, not compliant"
              },
              {
                "code": "MISSING",
                "labelAr": "غير موجودة",
                "labelEn": "Missing"
              }
            ]
          },
          {
            "code": "safetyEquipment",
            "labelAr": "أدوات السلامة متوفرة",
            "labelEn": "Safety equipment in place",
            "type": "CHECKBOX",
            "required": false,
            "options": []
          },
          {
            "code": "followUpDate",
            "labelAr": "موعد المتابعة",
            "labelEn": "Follow-up date",
            "type": "DATE",
            "required": false,
            "options": []
          }
        ],
        "photosRequired": 1,
        "requireLocation": true,
        "requireSignature": true,
        "inspectorRole": "FIELD_INSPECTOR",
        "dueDays": 5
      }
    },
    {
      "entityType": "vis.visit-type",
      "entityCode": "SAFETY_INSPECTION",
      "operation": "CREATE",
      "payload": {
        "nameAr": "معاينة السلامة",
        "nameEn": "Safety inspection",
        "mode": "EXTERNAL",
        "descriptionAr": "تُحال إلى جهة معاينة السلامة عبر بوابة الوزارة، وترد النتيجة بالاستعلام الدوري أو بإشعار موقّع.",
        "descriptionEn": "Referred to the safety inspection body through the ministry gateway; the result comes by periodic checks or a signed notification.",
        "outcomes": [
          {
            "code": "COMPLIANT",
            "nameAr": "مطابق",
            "nameEn": "Compliant",
            "kind": "PASS"
          },
          {
            "code": "NON_COMPLIANT",
            "nameAr": "غير مطابق",
            "nameEn": "Not compliant",
            "kind": "FAIL"
          }
        ],
        "fields": [],
        "photosRequired": 0,
        "requireLocation": false,
        "requireSignature": false,
        "dueDays": 10,
        "external": {
          "createOperation": "CIS_BOOK_INSPECTION",
          "inputs": {
            "visitNumber": {
              "var": "visit.number"
            },
            "siteAddress": {
              "var": "visit.siteAddress"
            },
            "activity": {
              "var": "data.PRT_EVENT_NAME"
            },
            "dueDate": {
              "var": "visit.dueDate"
            }
          },
          "referenceOutput": "reference",
          "resultOperation": "CIS_INSPECTION_RESULT",
          "pollMinutes": 1,
          "result": {
            "reference": "inspectionId",
            "status": "status",
            "completedValue": "COMPLETED",
            "outcome": "result",
            "data": "findings",
            "report": "summary"
          },
          "outcomeMap": {},
          "callbackSecret": "CIS_CALLBACK"
        }
      }
    },
    {
      "entityType": "wf.workflow-version",
      "entityCode": "SITE_VISIT/2",
      "operation": "CREATE",
      "payload": {
        "nameAr": "الإصدار 2 — زيارة المفتش للموقع",
        "nameEn": "Version 2 — an inspector visits the site",
        "definition": {
          "slaWorkingDays": 10,
          "nodes": [
            {
              "code": "START",
              "type": "START",
              "nameAr": "تقديم الطلب",
              "nameEn": "Submitted",
              "next": "SITE"
            },
            {
              "code": "SITE",
              "type": "VISIT",
              "nameAr": "معاينة الموقع",
              "nameEn": "Site inspection",
              "visitType": "SITE_INSPECTION",
              "site": {
                "var": "data.PRT_LOCATION"
              },
              "instructions": "تواصل مع مقدم الطلب قبل الزيارة بيوم.",
              "dueDays": 5,
              "outcomes": {
                "NON_COMPLIANT": "REJECTED"
              },
              "next": "APPROVED",
              "cancelled": "CLOSED"
            },
            {
              "code": "APPROVED",
              "type": "END",
              "nameAr": "اكتمال الطلب",
              "nameEn": "Completed",
              "outcome": "APPROVED"
            },
            {
              "code": "REJECTED",
              "type": "END",
              "nameAr": "رفض لعدم المطابقة",
              "nameEn": "Rejected: not compliant",
              "outcome": "REJECTED",
              "displayStatus": "REJECTED_NOT_COMPLIANT"
            },
            {
              "code": "CLOSED",
              "type": "END",
              "nameAr": "إغلاق دون زيارة",
              "nameEn": "Closed without a visit",
              "outcome": "CLOSED",
              "displayStatus": "CLOSED_NO_VISIT"
            }
          ],
          "layout": {
            "START": {
              "x": 304,
              "y": 24
            },
            "SITE": {
              "x": 304,
              "y": 144
            },
            "APPROVED": {
              "x": 64,
              "y": 304
            },
            "REJECTED": {
              "x": 304,
              "y": 304
            },
            "CLOSED": {
              "x": 544,
              "y": 304
            }
          }
        }
      }
    },
    {
      "entityType": "wf.workflow-version",
      "entityCode": "EVENT_PERMIT/2",
      "operation": "CREATE",
      "payload": {
        "nameAr": "الإصدار 2 — معاينة السلامة لدى الجهة المختصة",
        "nameEn": "Version 2 — safety inspection by the inspection body",
        "definition": {
          "slaWorkingDays": 10,
          "nodes": [
