      }
    },
    {
      "entityType": "apps.user",
      "entityCode": "inspector1",
      "operation": "CREATE",
      "payload": {
        "nameAr": "المفتش الأول",
        "nameEn": "First Inspector",
        "email": "inspector1@dynamic-cube.local",
        "status": "ACTIVE",
        "roles": [
