{
  "title": "Site visits",
  "items": [
    {
      "entityType": "integ.operation",
      "entityCode": "CIS_BOOK_INSPECTION",
      "operation": "CREATE",
      "payload": {
        "nameAr": "حجز معاينة سلامة",
        "nameEn": "Book a safety inspection",
        "connectionCode": "MOMRAH_GATEWAY",
        "envelopeProfileCode": "MOMRAH",
        "descriptionAr": "يحيل طلب معاينة السلامة إلى جهة المعاينة ويعيد رقم المعاينة لديها.",
        "descriptionEn": "Refers a safety inspection to the inspection body and returns its inspection number.",
        "method": "POST",
        "pathTemplate": "/v1/CIS/inspections",
        "isIdempotent": false,
        "parameters": [
          {
            "name": "visitNumber",
            "location": "BODY",
            "isRequired": true,
            "isMasked": false,
            "sampleValue": "VIS-2026-000001"
          },
          {
            "name": "siteAddress",
            "location": "BODY",
            "isRequired": false,
            "isMasked": false,
            "sampleValue": "الرياض، حي العليا"
          },
          {
            "name": "activity",
            "location": "BODY",
            "isRequired": false,
            "isMasked": false,
            "sampleValue": "فعالية مؤقتة"
          },
          {
            "name": "dueDate",
            "location": "BODY",
            "isRequired": false,
            "isMasked": false,
            "sampleValue": "2026-11-05"
          }
        ],
        "outputs": [
          {
            "name": "reference",
            "path": "inspectionId"
          }
        ],
        "responseCodes": [
          {
            "code": "003-000001",
            "outcome": "BUSINESS_ERROR",
            "messageAr": "رقم الزيارة مطلوب.",
            "messageEn": "The visit number is required."
          }
        ]
      }
    },
    {
      "entityType": "integ.operation",
      "entityCode": "CIS_INSPECTION_RESULT",
      "operation": "CREATE",
      "payload": {
        "nameAr": "نتيجة معاينة السلامة",
        "nameEn": "Safety inspection result",
        "connectionCode": "MOMRAH_GATEWAY",
        "envelopeProfileCode": "MOMRAH",
        "descriptionAr": "يستعلم عن حالة المعاينة ونتيجتها وملاحظاتها.",
        "descriptionEn": "Reads the inspection's status, result and findings.",
        "method": "GET",
        "pathTemplate": "/v1/CIS/inspections/{reference}",
        "isIdempotent": true,
        "parameters": [
          {
            "name": "reference",
            "location": "PATH",
            "isRequired": true,
            "isMasked": false,
            "sampleValue": "INS-100001"
          }
        ],
        "outputs": [
          {
            "name": "inspectionId",
            "path": "inspectionId"
          },
          {
            "name": "status",
            "path": "status"
          },
          {
            "name": "result",
            "path": "result"
          },
          {
            "name": "findings",
            "path": "findings"
          },
          {
            "name": "summary",
            "path": "summary"
          }
        ],
        "responseCodes": [
          {
            "code": "003-000002",
            "outcome": "NOT_FOUND",
            "messageAr": "المعاينة غير موجودة.",
            "messageEn": "The inspection does not exist."
          }
        ]
      }
    },
    {
