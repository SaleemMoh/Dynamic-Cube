    {
      "entityType": "svc.service-version",
      "entityCode": "EVENT_PERMIT/1",
      "operation": "CREATE",
      "payload": {
        "nameAr": "الإصدار 1",
        "nameEn": "Version 1",
        "definition": {
          "levels": [
            {
              "code": "STANDARD",
              "nameAr": "عادي",
              "nameEn": "Standard",
              "slaWorkingDays": 5
            }
          ],
          "steps": [
            {
              "code": "DETAILS",
              "type": "FORM",
              "titleAr": "البيانات",
              "titleEn": "Details",
              "sections": [
                {
                  "code": "DETAILS_S",
                  "titleAr": "البيانات",
                  "titleEn": "Details",
                  "questions": [
                    {
                      "code": "PRT_EVENT_NAME",
                      "required": true,
                      "readonly": false
                    },
                    {
                      "code": "PRT_EVENT_DATE",
                      "required": true,
                      "readonly": false
                    },
                    {
                      "code": "PRT_LOCATION",
                      "required": true,
                      "readonly": false
                    },
                    {
                      "code": "PRT_ATTENDEES",
                      "required": true,
                      "readonly": false
                    }
                  ]
                }
              ]
            },
            {
              "code": "FEES",
              "type": "FEES",
              "titleAr": "الرسوم",
              "titleEn": "Fees",
              "sections": []
            },
            {
              "code": "REVIEW",
              "type": "REVIEW",
              "titleAr": "مراجعة الطلب",
              "titleEn": "Review",
              "sections": []
            },
            {
              "code": "DECLARATION",
              "type": "DECLARATION",
              "titleAr": "الإقرار",
              "titleEn": "Declaration",
              "sections": [],
              "textAr": "أقر بصحة البيانات المقدمة وأتحمل المسؤولية النظامية عنها.",
              "textEn": "I confirm the data submitted is correct and bear legal responsibility for it."
            }
          ],
          "eligibility": [],
          "validations": [],
          "fees": [
            {
              "code": "PERMIT_FEE",
              "nameAr": "رسوم التصريح",
              "nameEn": "Permit fee",
              "fixed": 500,
              "vatRate": 0.15,
              "vatIncluded": true
            }
          ],
          "card": {
            "audienceAr": "الأفراد والمنشآت",
            "audienceEn": "Individuals and establishments",
            "steps": [
              {
                "textAr": "تعبئة بيانات الفعالية وموقعها وعدد الحضور",
                "textEn": "Fill in the event, its location and attendance"
              },
              {
                "textAr": "سداد الرسوم وتقديم الطلب",
                "textEn": "Pay the fee and submit"
              },
              {
                "textAr": "استلام التصريح",
                "textEn": "Receive the permit"
              }
            ],
            "termsAr": "أن تكون البيانات المقدمة صحيحة ومحدثة.\nيحق للجهة رفض الطلب إذا لم يستوفِ الشروط.",
            "termsEn": "The data submitted is correct and up to date.\nThe entity may reject a request that does not meet the conditions.",
            "requiredDocuments": [
              {
                "nameAr": "مخطط الموقع",
                "nameEn": "Site plan"
              },
              {
                "nameAr": "موافقة مالك الموقع",
                "nameEn": "Site owner's consent",
                "noteAr": "للمواقع الخاصة",
                "noteEn": "For private sites"
              }
            ],
            "channels": [
              "PORTAL",
              "MOBILE_APP"
            ],
            "phone": "199040",
            "email": "info@example.gov.sa"
          }
        }
      }
    },
