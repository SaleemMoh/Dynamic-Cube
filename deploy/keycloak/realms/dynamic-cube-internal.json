{
  "realm": "dynamic-cube-internal",
  "displayName": "ديناميك كيوب — النظام الداخلي",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ar",
    "en"
  ],
  "defaultLocale": "ar",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "dynamic-cube-internal-web",
      "name": "Internal system (SPA)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:4202/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://localhost:4202"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://localhost:4202/*"
      },
      "protocolMappers": [
        {
          "name": "audience-dynamic-cube-internal-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "dynamic-cube-internal-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "dynamic-cube-dev-tools",
      "name": "Development tools (password grant, dev only)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "audience-dynamic-cube-internal-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "dynamic-cube-internal-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "dynamic-cube-internal-api",
      "name": "Internal API (token audience)",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "dynamic-cube-accounts",
      "name": "Dynamic Cube account management (Apps Control)",
      "description": "Service account the internal API uses to create users, enable/disable them and set passwords. Development secret only.",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-accounts-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
