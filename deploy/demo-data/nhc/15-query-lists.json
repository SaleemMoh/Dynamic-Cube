        "dbSchema": "apps",
        "dbObject": "sys_company_branches",
        "objectType": "TABLE",
        "columns": [
          {
            "name": "branch_code",
            "labelAr": "رمز الفرع",
            "labelEn": "Branch code"
          },
          {
            "name": "branch_desc_ntv",
            "labelAr": "اسم الفرع بالعربية",
            "labelEn": "Arabic name"
          },
          {
            "name": "branch_desc_frn",
            "labelAr": "اسم الفرع بالإنجليزية",
            "labelEn": "English name"
          },
          {
            "name": "cmp_num",
            "labelAr": "الشركة",
            "labelEn": "Company"
          },
          {
            "name": "region_code",
            "labelAr": "المنطقة",
            "labelEn": "Region"
          },
          {
            "name": "city",
            "labelAr": "المدينة",
            "labelEn": "City"
          },
          {
            "name": "is_active",
            "labelAr": "نشط",
            "labelEn": "Active"
          },
          {
            "name": "order_num",
            "labelAr": "ترتيب العرض",
            "labelEn": "Display order"
          }
        ],
        "scopeBindings": []
      }
    },
    {
      "entityType": "apps.lov",
      "entityCode": "MY_BRANCHES_BY_REGION",
      "operation": "CREATE",
      "payload": {
        "nameAr": "فروعي حسب المنطقة",
        "nameEn": "My branches by region",
        "sourceType": "QUERY",
        "query": {
          "from": {
            "kind": "DATA_OBJECT",
            "code": "BRANCHES",
            "alias": "b"
          },
          "joins": [
            {
              "kind": "CLASS",
              "code": "REGION",
              "alias": "r",
              "type": "LEFT",
              "on": [
                {
                  "left": "b.region_code",
                  "right": "r.code"
                }
              ]
            }
          ],
          "map": {
            "value": "b.branch_code",
            "labelAr": "b.branch_desc_ntv",
            "labelEn": "b.branch_desc_frn",
            "parent": "r.code"
          },
          "where": {
            "match": "ALL",
            "conditions": [
              {
                "column": "b.cmp_num",
                "op": "IN",
                "user": "COMPANY"
              },
              {
                "column": "b.branch_code",
                "op": "IN",
                "user": "BRANCHES"
              }
            ],
            "groups": [
              {
                "match": "ALL",
                "conditions": [
                  {
                    "column": "b.is_active",
                    "op": "EQ",
                    "value": true
                  }
                ],
                "groups": []
              }
            ]
          },
          "sort": [
            {
              "column": "r.display_order",
              "direction": "ASC"
            },
            {
              "column": "b.order_num",
              "direction": "ASC"
            }
          ],
          "distinct": false
        },
        "searchMode": "FULL",
        "maxRows": 500,
        "defaultSelectionMode": "SINGLE",
        "requiresGrant": false,
        "isPublic": false,
        "businessApp": "CLASSIFICATION",
        "bindings": []
      }
    }
  ]
}
