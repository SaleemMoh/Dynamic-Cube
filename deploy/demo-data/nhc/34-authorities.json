    {
      "entityType": "integ.operation",
      "entityCode": "BALADY_AUTHORIZATION",
      "operation": "CREATE",
      "payload": {
        "nameAr": "التحقق من تفويض بلدي",
        "nameEn": "Check a Balady authorization",
        "connectionCode": "MOMRAH_GATEWAY",
        "envelopeProfileCode": "MOMRAH",
        "method": "GET",
        "pathTemplate": "/v1/AUTHORITIES/balady/{number}",
        "parameters": [
          {
            "name": "number",
            "location": "PATH",
            "isRequired": true,
            "isMasked": false,
            "sampleValue": "BL-100200"
          },
          {
            "name": "crNumber",
            "location": "QUERY",
            "isRequired": true,
            "isMasked": false,
            "sampleValue": "1010000002"
          },
          {
            "name": "idNumber",
            "location": "QUERY",
            "isRequired": true,
            "isMasked": true,
            "sampleValue": "1000000001"
          }
        ],
        "outputs": [
          {
            "name": "valid",
            "path": "valid"
          },
          {
            "name": "expiresOn",
            "path": "expiresOn"
          },
          {
            "name": "firmNameAr",
            "path": "firmNameAr"
          },
          {
            "name": "firmNameEn",
            "path": "firmNameEn"
          }
        ],
        "responseCodes": [
          {
            "code": "005-000001",
            "outcome": "BUSINESS_ERROR",
            "messageAr": "لم يُعثر على هذا الرقم لدى الجهة.",
            "messageEn": "The provider has no authority with this number."
          },
          {
            "code": "005-000002",
            "outcome": "BUSINESS_ERROR",
            "messageAr": "رقم السجل التجاري غير صحيح.",
            "messageEn": "The CR number is not valid."
          }
        ],
        "maskFields": [],
        "cacheSeconds": 0,
        "isIdempotent": true
      }
    },
