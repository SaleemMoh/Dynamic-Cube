        "nameAr": "خدمات الموردين",
        "nameEn": "Supplier services",
        "displayOrder": 30,
        "attributes": {
          "DESCRIPTION_AR": "التسجيل موردًا لدى الشركة الوطنية للإسكان وما يرتبط به من طلبات",
          "DESCRIPTION_EN": "Registering as a National Housing Company supplier and the requests linked to it",
          "ICON": "local_shipping"
        }
      }
    },
    {
      "entityType": "svc.question",
      "entityCode": "SUP_CONTACT_NAME",
      "operation": "CREATE",
      "payload": {
        "nameAr": "اسم مسؤول التواصل",
        "nameEn": "Contact person",
        "type": "TEXT",
        "validation": {
          "maxLength": 120
        }
      }
    },
    {
      "entityType": "svc.question",
      "entityCode": "SUP_CONTACT_MOBILE",
      "operation": "CREATE",
      "payload": {
        "nameAr": "جوال مسؤول التواصل",
        "nameEn": "Contact mobile",
        "type": "TEXT",
        "hintAr": "مثال: 0512345678",
        "hintEn": "e.g. 0512345678",
        "validation": {
          "pattern": "^05[0-9]{8}$"
        }
      }
    },
    {
      "entityType": "svc.question",
      "entityCode": "SUP_EMAIL",
      "operation": "CREATE",
      "payload": {
        "nameAr": "البريد الإلكتروني للمراسلات",
        "nameEn": "Email for correspondence",
        "type": "TEXT",
        "validation": {
          "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
          "maxLength": 120
        }
      }
    },
    {
