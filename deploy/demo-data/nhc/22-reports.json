    {
      "entityType": "rpt.report",
      "entityCode": "REQUESTS_BY_SERVICE",
      "operation": "CREATE",
      "payload": {
        "nameAr": "الطلبات حسب الخدمة والحالة والفرع",
        "nameEn": "Requests by service, status and branch",
        "descriptionAr": "الطلبات المقدّمة (دون المسودات) مجمّعة حسب الخدمة والحالة والفرع، مع الرسوم.",
        "descriptionEn": "Submitted requests (drafts left out) grouped by service, status and branch, with their fees.",
        "categoryAr": "تقارير التصنيف",
        "categoryEn": "Classification reports",
        "icon": "bar_chart",
        "query": {
          "from": {
            "kind": "DATA_OBJECT",
            "code": "REQUESTS",
            "alias": "r"
          },
          "joins": [
            {
              "kind": "DATA_OBJECT",
              "code": "SERVICES",
              "alias": "s",
              "type": "LEFT",
              "on": [
                {
                  "left": "r.service_code",
                  "right": "s.code"
                }
              ]
            },
            {
              "kind": "DATA_OBJECT",
              "code": "BRANCHES",
              "alias": "b",
              "type": "LEFT",
              "on": [
                {
                  "left": "r.branch_code",
                  "right": "b.branch_code"
                }
              ]
            }
          ],
          "where": {
            "match": "ALL",
            "conditions": [
              {
                "column": "r.status_category",
                "op": "NE",
                "value": "Draft"
              },
              {
                "column": "r.submitted_at",
                "op": "GE",
                "param": "from"
              },
              {
                "column": "r.service_code",
                "op": "IN",
                "param": "service"
              },
              {
                "column": "r.branch_code",
                "op": "IN",
                "param": "branch"
              }
            ],
            "groups": []
          },
          "sort": [],
          "distinct": false
        },
        "columns": [
          {
            "name": "service",
            "labelAr": "الخدمة",
            "labelEn": "Service",
            "column": "s.name_ar",
            "aggregate": null
          },
          {
            "name": "status",
            "labelAr": "الحالة",
            "labelEn": "Status",
            "column": "r.display_status",
            "aggregate": null
          },
          {
            "name": "branch",
            "labelAr": "الفرع",
            "labelEn": "Branch",
            "column": "b.branch_desc_ntv",
            "aggregate": null
          },
          {
            "name": "requests",
            "labelAr": "عدد الطلبات",
            "labelEn": "Requests",
            "column": "r.service_code",
            "aggregate": "COUNT"
          },
          {
            "name": "fees",
            "labelAr": "الرسوم",
            "labelEn": "Fees",
            "column": "r.fee_total",
            "aggregate": "SUM"
          }
        ],
        "filters": [
          {
            "name": "from",
            "labelAr": "مقدّمة منذ",
            "labelEn": "Submitted since",
            "type": "DATE",
            "lov": null,
            "multiple": false,
            "required": false,
            "default": "YEAR_START"
          },
          {
            "name": "service",
            "labelAr": "الخدمة",
            "labelEn": "Service",
            "type": "LIST",
            "lov": "REPORT_SERVICES",
            "multiple": true,
            "required": false,
            "default": null
          },
          {
            "name": "branch",
            "labelAr": "الفرع",
            "labelEn": "Branch",
            "type": "LIST",
            "lov": "MY_BRANCHES_BY_REGION",
            "multiple": true,
            "required": false,
            "default": null
          }
        ],
        "tiles": [
          {
            "name": "requests",
            "labelAr": "الطلبات",
            "labelEn": "Requests",
            "column": null,
            "aggregate": "COUNT"
          },
          {
            "name": "services",
            "labelAr": "الخدمات",
            "labelEn": "Services",
            "column": "r.service_code",
            "aggregate": "COUNT_DISTINCT"
          },
          {
            "name": "fees",
            "labelAr": "إجمالي الرسوم",
            "labelEn": "Total fees",
            "column": "r.fee_total",
            "aggregate": "SUM"
          }
        ],
        "sort": [
          {
            "column": "requests",
            "descending": true
          }
        ],
        "totals": true,
        "pageSize": 50,
        "businessApps": [
          "CLASSIFICATION"
        ],
        "charts": [
          {
            "name": "chart1",
            "titleAr": "الطلبات حسب الخدمة والحالة والفرع",
            "titleEn": "Requests by service, status and branch",
            "type": "BAR",
            "x": [
              {
                "column": "s.name_ar",
                "labelAr": "الخدمة",
                "labelEn": "Service"
              }
            ],
            "y": [
              {
                "column": "r.service_code",
                "aggregate": "COUNT",
                "labelAr": "عدد الطلبات",
                "labelEn": "Requests"
              }
            ],
            "series": null,
            "stacked": false,
            "sort": "Y_DESC",
            "limit": 20,
            "width": "HALF"
          }
        ]
      }
    },
    {
      "entityType": "rpt.report",
      "entityCode": "OVERDUE_TASKS",
      "operation": "CREATE",
      "payload": {
        "nameAr": "المهام المتأخرة عن موعدها",
        "nameEn": "Overdue tasks",
        "descriptionAr": "المهام المفتوحة التي تجاوزت موعد استحقاقها، حسب الخطوة والفرع والدور، مع أقدم موعد.",
        "descriptionEn": "Open tasks past their due time by step, branch and role, with the oldest due time.",
        "categoryAr": "تقارير التصنيف",
        "categoryEn": "Classification reports",
        "icon": "alarm",
        "query": {
          "from": {
            "kind": "DATA_OBJECT",
            "code": "WF_TASKS",
            "alias": "t"
          },
          "joins": [
            {
              "kind": "DATA_OBJECT",
              "code": "BRANCHES",
              "alias": "b",
              "type": "LEFT",
              "on": [
                {
                  "left": "t.branch_code",
                  "right": "b.branch_code"
                }
              ]
            }
          ],
          "where": {
            "match": "ALL",
            "conditions": [
              {
                "column": "t.status",
                "op": "EQ",
                "value": "Open"
              },
              {
                "column": "t.due_at",
                "op": "LT",
                "param": "asOf"
              },
              {
                "column": "t.service_code",
                "op": "IN",
                "param": "service"
              }
            ],
            "groups": []
          },
          "sort": [],
          "distinct": false
        },
        "columns": [
          {
            "name": "step",
            "labelAr": "الخطوة",
            "labelEn": "Step",
            "column": "t.name_ar",
            "aggregate": null
          },
          {
            "name": "branch",
            "labelAr": "الفرع",
            "labelEn": "Branch",
            "column": "b.branch_desc_ntv",
            "aggregate": null
          },
          {
            "name": "role",
            "labelAr": "الدور",
            "labelEn": "Role",
            "column": "t.candidate_role",
            "aggregate": null
          },
          {
            "name": "tasks",
            "labelAr": "عدد المهام",
            "labelEn": "Tasks",
            "column": "t.node_code",
            "aggregate": "COUNT"
          },
          {
            "name": "oldestDue",
            "labelAr": "أقدم موعد",
            "labelEn": "Oldest due",
            "column": "t.due_at",
            "aggregate": "MIN"
          }
        ],
        "filters": [
          {
            "name": "asOf",
            "labelAr": "متأخرة حتى",
            "labelEn": "Overdue as of",
            "type": "DATE",
            "lov": null,
            "multiple": false,
            "required": true,
            "default": "TODAY"
          },
          {
            "name": "service",
            "labelAr": "الخدمة",
            "labelEn": "Service",
            "type": "LIST",
            "lov": "REPORT_SERVICES",
            "multiple": true,
            "required": false,
            "default": null
          }
        ],
        "tiles": [
          {
            "name": "overdue",
            "labelAr": "مهام متأخرة",
            "labelEn": "Overdue tasks",
            "column": null,
            "aggregate": "COUNT"
          },
          {
            "name": "oldest",
            "labelAr": "أقدم موعد",
            "labelEn": "Oldest due",
            "column": "t.due_at",
            "aggregate": "MIN"
          }
        ],
        "sort": [
          {
            "column": "tasks",
            "descending": true
          }
        ],
        "totals": true,
        "pageSize": 50,
        "businessApps": [
          "CLASSIFICATION"
        ],
        "charts": [
          {
            "name": "chart1",
            "titleAr": "المهام المتأخرة عن موعدها",
            "titleEn": "Overdue tasks",
            "type": "BAR",
            "x": [
              {
                "column": "t.name_ar",
                "labelAr": "الخطوة",
                "labelEn": "Step"
              }
            ],
            "y": [
              {
                "column": "t.node_code",
                "aggregate": "COUNT",
                "labelAr": "عدد المهام",
                "labelEn": "Tasks"
              }
            ],
            "series": null,
            "stacked": false,
            "sort": "Y_DESC",
            "limit": 20,
            "width": "HALF"
          }
        ]
      }
    },
