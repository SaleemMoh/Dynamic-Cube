    {
      "entityType": "rpt.report",
      "entityCode": "ABANDONED_DRAFTS",
      "operation": "CREATE",
      "payload": {
        "nameAr": "المسودات المتروكة حسب الخطوة",
        "nameEn": "Abandoned drafts by step",
        "descriptionAr": "مسودات لم يُكمل أصحابها تقديمها ولم تُحدَّث منذ التاريخ المختار، حسب الخدمة والخطوة التي توقفوا عندها.",
        "descriptionEn": "Drafts their owners have not submitted nor touched since the chosen date, by service and the step they stopped at.",
        "categoryAr": "تقارير التصنيف",
        "categoryEn": "Classification reports",
        "icon": "edit_note",
        "query": {
          "from": {
            "kind": "DATA_OBJECT",
            "code": "REQUESTS",
            "alias": "r"
          },
          "joins": [
            {
              "kind": "DATA_OBJECT",
              "code": "SERVICES",
              "alias": "s",
              "type": "LEFT",
              "on": [
                {
                  "left": "r.service_code",
                  "right": "s.code"
                }
              ]
            }
          ],
          "where": {
            "match": "ALL",
            "conditions": [
              {
                "column": "r.status_category",
                "op": "EQ",
                "value": "Draft"
              },
              {
                "column": "r.updated_at",
                "op": "LT",
                "param": "idleSince"
              }
            ],
            "groups": []
          },
          "sort": [],
          "distinct": false
        },
        "columns": [
          {
            "name": "service",
            "labelAr": "الخدمة",
            "labelEn": "Service",
            "column": "s.name_ar",
            "aggregate": null
          },
          {
            "name": "step",
            "labelAr": "الخطوة",
            "labelEn": "Step",
            "column": "r.current_step",
            "aggregate": null
          },
          {
