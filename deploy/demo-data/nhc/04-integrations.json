        "connectionCode": "MOMRAH_GATEWAY",
        "envelopeProfileCode": "MOMRAH",
        "method": "GET",
        "pathTemplate": "/v1/MCI-DIP/CR-Information/{crNumber}",
        "parameters": [
          {
