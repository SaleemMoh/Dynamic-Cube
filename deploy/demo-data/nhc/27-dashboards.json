    {
      "entityType": "rpt.report",
      "entityCode": "OVERDUE_TASKS",
      "operation": "UPSERT",
      "payload": {
        "nameAr": "المهام المتأخرة عن موعدها",
        "nameEn": "Overdue tasks",
        "descriptionAr": "المهام المفتوحة التي تجاوزت موعد استحقاقها، حسب الخطوة والفرع والدور، مع أقدم موعد.",
        "descriptionEn": "Open tasks past their due time by step, branch and role, with the oldest due time.",
        "categoryAr": "تقارير التصنيف",
        "categoryEn": "Classification reports",
        "icon": "alarm",
        "query": {
          "from": {
            "kind": "DATA_OBJECT",
            "code": "WF_TASKS",
            "alias": "t"
          },
          "joins": [
            {
              "kind": "DATA_OBJECT",
              "code": "BRANCHES",
              "alias": "b",
              "type": "LEFT",
              "on": [
                {
                  "left": "t.branch_code",
                  "right": "b.branch_code"
                }
              ]
            }
          ],
          "where": {
            "match": "ALL",
            "conditions": [
              {
                "column": "t.status",
                "op": "EQ",
                "value": "Open"
              },
              {
                "column": "t.due_at",
                "op": "LT",
                "param": "asOf"
              },
              {
                "column": "t.service_code",
                "op": "IN",
                "param": "service"
              }
            ],
            "groups": []
          },
          "sort": [],
          "distinct": false
        },
        "columns": [
          {
            "name": "step",
            "labelAr": "الخطوة",
            "labelEn": "Step",
            "column": "t.name_ar",
            "aggregate": null
          },
          {
            "name": "branch",
            "labelAr": "الفرع",
            "labelEn": "Branch",
            "column": "b.branch_desc_ntv",
            "aggregate": null
          },
          {
            "name": "role",
            "labelAr": "الدور",
            "labelEn": "Role",
            "column": "t.candidate_role",
            "aggregate": null
          },
          {
            "name": "tasks",
            "labelAr": "عدد المهام",
            "labelEn": "Tasks",
            "column": "t.node_code",
            "aggregate": "COUNT"
          },
          {
            "name": "oldestDue",
            "labelAr": "أقدم موعد",
            "labelEn": "Oldest due",
            "column": "t.due_at",
            "aggregate": "MIN"
          }
        ],
        "filters": [
          {
            "name": "asOf",
            "labelAr": "متأخرة حتى",
            "labelEn": "Overdue as of",
            "type": "DATE",
            "lov": null,
            "multiple": false,
            "required": true,
            "default": "TODAY"
          },
          {
            "name": "service",
            "labelAr": "الخدمة",
            "labelEn": "Service",
            "type": "LIST",
            "lov": "REPORT_SERVICES",
            "multiple": true,
            "required": false,
            "default": null
          }
        ],
        "tiles": [
          {
            "name": "overdue",
            "labelAr": "مهام متأخرة",
            "labelEn": "Overdue tasks",
            "column": null,
            "aggregate": "COUNT"
          },
          {
            "name": "oldest",
            "labelAr": "أقدم موعد",
            "labelEn": "Oldest due",
            "column": "t.due_at",
            "aggregate": "MIN"
          }
        ],
        "sort": [
          {
            "column": "tasks",
            "descending": true
          }
        ],
        "totals": true,
        "pageSize": 50,
        "businessApps": [
          "CLASSIFICATION"
        ],
        "charts": [
          {
            "name": "chart1",
            "titleAr": "المهام المتأخرة عن موعدها",
            "titleEn": "Overdue tasks",
            "type": "BAR",
            "x": [
              {
                "column": "t.name_ar",
