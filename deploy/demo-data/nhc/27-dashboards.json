{
  "title": "NHC — a shared dashboard (classification overview) and the rows behind the reports' groups (demo)",
  "items": [
    {
      "entityType": "rpt.report",
      "entityCode": "REQUESTS_BY_SERVICE",
      "operation": "UPSERT",
      "payload": {
        "nameAr": "الطلبات حسب الخدمة والحالة والفرع",
        "nameEn": "Requests by service, status and branch",
        "descriptionAr": "الطلبات المقدّمة (دون المسودات) مجمّعة حسب الخدمة والحالة والفرع، مع الرسوم.",
        "descriptionEn": "Submitted requests (drafts left out) grouped by service, status and branch, with their fees.",
        "categoryAr": "تقارير التصنيف",
        "categoryEn": "Classification reports",
        "icon": "bar_chart",
        "query": {
          "from": {
            "kind": "DATA_OBJECT",
            "code": "REQUESTS",
            "alias": "r"
          },
          "joins": [
            {
              "kind": "DATA_OBJECT",
              "code": "SERVICES",
              "alias": "s",
              "type": "LEFT",
              "on": [
                {
                  "left": "r.service_code",
                  "right": "s.code"
                }
              ]
            },
            {
              "kind": "DATA_OBJECT",
              "code": "BRANCHES",
              "alias": "b",
              "type": "LEFT",
              "on": [
                {
                  "left": "r.branch_code",
                  "right": "b.branch_code"
                }
              ]
            }
          ],
          "where": {
            "match": "ALL",
            "conditions": [
              {
                "column": "r.status_category",
                "op": "NE",
                "value": "Draft"
              },
              {
                "column": "r.submitted_at",
                "op": "GE",
                "param": "from"
              },
              {
                "column": "r.service_code",
                "op": "IN",
                "param": "service"
              },
              {
                "column": "r.branch_code",
                "op": "IN",
                "param": "branch"
              }
            ],
            "groups": []
          },
          "sort": [],
          "distinct": false
        },
        "columns": [
          {
            "name": "service",
            "labelAr": "الخدمة",
            "labelEn": "Service",
            "column": "s.name_ar",
            "aggregate": null
          },
          {
            "name": "status",
            "labelAr": "الحالة",
            "labelEn": "Status",
            "column": "r.display_status",
            "aggregate": null
          },
          {
            "name": "branch",
            "labelAr": "الفرع",
            "labelEn": "Branch",
            "column": "b.branch_desc_ntv",
            "aggregate": null
          },
          {
            "name": "requests",
            "labelAr": "عدد الطلبات",
            "labelEn": "Requests",
            "column": "r.service_code",
            "aggregate": "COUNT"
          },
          {
            "name": "fees",
            "labelAr": "الرسوم",
            "labelEn": "Fees",
            "column": "r.fee_total",
            "aggregate": "SUM"
          }
        ],
        "filters": [
          {
            "name": "from",
            "labelAr": "مقدّمة منذ",
            "labelEn": "Submitted since",
            "type": "DATE",
            "lov": null,
            "multiple": false,
            "required": false,
            "default": "YEAR_START"
          },
          {
            "name": "service",
            "labelAr": "الخدمة",
            "labelEn": "Service",
            "type": "LIST",
            "lov": "REPORT_SERVICES",
            "multiple": true,
            "required": false,
            "default": null
          },
          {
            "name": "branch",
            "labelAr": "الفرع",
            "labelEn": "Branch",
            "type": "LIST",
            "lov": "MY_BRANCHES_BY_REGION",
            "multiple": true,
            "required": false,
            "default": null
          }
        ],
        "tiles": [
          {
            "name": "requests",
            "labelAr": "الطلبات",
            "labelEn": "Requests",
            "column": null,
            "aggregate": "COUNT"
          },
          {
            "name": "services",
            "labelAr": "الخدمات",
            "labelEn": "Services",
            "column": "r.service_code",
            "aggregate": "COUNT_DISTINCT"
          },
          {
            "name": "fees",
            "labelAr": "إجمالي الرسوم",
            "labelEn": "Total fees",
            "column": "r.fee_total",
            "aggregate": "SUM"
          }
        ],
        "sort": [
          {
            "column": "requests",
            "descending": true
          }
        ],
        "totals": true,
        "pageSize": 50,
        "businessApps": [
          "CLASSIFICATION"
        ],
        "charts": [
