    {
      "entityType": "apps.lov",
      "entityCode": "MY_BRANCHES_BY_REGION",
      "operation": "UPSERT",
      "payload": {
        "nameAr": "فروعي حسب المنطقة",
        "nameEn": "My branches by region",
        "sourceType": "QUERY",
        "query": {
          "from": {
            "kind": "DATA_OBJECT",
            "code": "BRANCHES",
            "alias": "b"
          },
          "joins": [
            {
              "kind": "CLASS",
              "code": "REGION",
              "alias": "r",
              "type": "LEFT",
              "on": [
                {
                  "left": "b.region_code",
                  "right": "r.code"
                }
              ]
            }
          ],
          "map": {
            "value": "b.branch_code",
            "labelAr": "b.branch_desc_ntv",
            "labelEn": "b.branch_desc_frn",
            "parent": "r.code"
          },
          "where": {
            "match": "ALL",
            "conditions": [
              {
                "column": "b.cmp_num",
                "op": "IN",
                "user": "COMPANY"
              },
              {
                "column": "b.branch_code",
                "op": "IN",
                "user": "BRANCHES"
              }
            ],
            "groups": [
              {
                "match": "ALL",
                "conditions": [
                  {
                    "column": "b.is_active",
                    "op": "EQ",
                    "value": true
                  }
                ],
                "groups": []
              }
            ]
          },
          "sort": [
            {
              "column": "r.display_order",
              "direction": "ASC"
            },
            {
              "column": "b.order_num",
              "direction": "ASC"
            }
          ],
          "distinct": false
        },
        "searchMode": "FULL",
        "maxRows": 500,
        "defaultSelectionMode": "SINGLE",
        "requiresGrant": false,
        "isPublic": false,
        "bindings": [],
        "businessApps": [
          "CLASSIFICATION",
          "PMS"
        ]
      }
    },
