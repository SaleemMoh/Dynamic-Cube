{
  "title": "Reusable service building blocks: record lists of an establishment (projects imported from Etimad or typed in), picked in a rows question",
  "items": [
    {
      "entityType": "integ.operation",
      "entityCode": "ETIMAD_CONTRACTS",
      "operation": "CREATE",
      "payload": {
        "nameAr": "عقود المنشأة في منصة اعتماد",
        "nameEn": "The establishment's contracts on Etimad",
        "connectionCode": "MOMRAH_GATEWAY",
        "envelopeProfileCode": "MOMRAH",
        "method": "GET",
        "pathTemplate": "/v1/ETIMAD/contracts/{crNumber}",
        "parameters": [
          {
            "name": "crNumber",
            "location": "PATH",
            "isRequired": true,
            "isMasked": false,
            "sampleValue": "1010012006"
          }
        ],
        "outputs": [
          {
            "name": "contractNumbers",
            "path": "contracts[*].contractNumber"
          }
        ],
        "responseCodes": [
          {
            "code": "004-000002",
            "outcome": "BUSINESS_ERROR",
            "messageAr": "رقم السجل التجاري غير صحيح.",
            "messageEn": "The CR number is not valid."
          }
        ],
        "maskFields": [],
        "cacheSeconds": 0,
        "isIdempotent": true
      }
    },
