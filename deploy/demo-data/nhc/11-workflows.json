                  "to": "JOIN"
                },
                {
                  "code": "BACK_TO_ANALYST",
                  "kind": "COMPLETE",
                  "nameAr": "إعادة للمحلل",
                  "nameEn": "Back to the analyst",
                  "commentRequired": true,
                  "to": "FIN_ANALYSIS"
                }
              ],
              "layout": {
                "x": 600,
                "y": 740
              }
            },
            {
              "code": "JOIN",
              "type": "JOIN",
              "nameAr": "اكتمال التقييم",
              "nameEn": "Evaluation complete",
              "mode": "ALL",
              "next": "GRADE",
              "layout": {
                "x": 340,
                "y": 850
              }
            },
            {
              "code": "GRADE",
              "type": "DECISION",
              "nameAr": "احتساب الدرجات",
              "nameEn": "Grade calculation",
              "ruleSet": "CLS_GRADING",
              "result": "grading",
              "input": {
                "sectors": {
                  "var": "data.CLS_DOMAINS"
                },
                "employees": {
                  "var": "data.CLS_EMPLOYEES"
                },
                "saudis": {
                  "var": "data.CLS_SAUDI_EMPLOYEES"
                },
                "engineers": {
                  "var": "data.CLS_ENGINEERS"
                },
                "technicians": {
                  "var": "data.CLS_TECHNICIANS"
                },
                "dgaCategory": {
                  "var": "data.CLS_DGA_CATEGORY"
                },
                "projectsValue": {
                  "var": "data.CLS_PROJECTS_VALUE"
                },
                "largestProject": {
                  "var": "data.CLS_LARGEST_PROJECT"
                },
                "creditRating": {
                  "var": "data.CLS_CREDIT_RATING"
                },
                "withdrawn": {
                  "==": [
                    {
                      "var": "data.CLS_WITHDRAWN"
                    },
                    "YES"
                  ]
                },
                "violations": {
                  "var": "data.CLS_VIOLATIONS"
                },
                "g1": {
                  "==": [
                    {
                      "var": "data.CLS_GOV_G1"
                    },
                    "YES"
                  ]
                },
                "g2": {
                  "in": [
                    {
                      "var": "data.CLS_GOV_G2"
                    },
                    [
                      "MONTHLY",
                      "QUARTERLY"
                    ]
                  ]
                },
                "g3": {
                  "==": [
                    {
                      "var": "data.CLS_GOV_G3"
                    },
                    "YES"
                  ]
                },
                "g4": {
                  "==": [
                    {
                      "var": "data.CLS_GOV_G4"
                    },
                    "YES"
                  ]
                },
                "g5": {
                  "==": [
                    {
                      "var": "data.CLS_GOV_G5"
                    },
                    "YES"
                  ]
                },
                "g6": {
                  "in": [
                    {
                      "var": "data.CLS_GOV_G6"
                    },
                    [
                      "MONTHLY",
                      "QUARTERLY"
                    ]
                  ]
                },
                "g7": {
                  "==": [
                    {
                      "var": "data.CLS_GOV_G7"
                    },
                    "YES"
                  ]
                },
                "g8": {
                  "==": [
                    {
                      "var": "data.CLS_GOV_G8"
                    },
                    "YES"
                  ]
                },
                "g9": {
                  "==": [
                    {
                      "var": "data.CLS_GOV_G9"
                    },
                    "YES"
                  ]
                },
                "g10": {
                  "==": [
                    {
                      "var": "data.CLS_GOV_G10"
                    },
                    "YES"
                  ]
                },
                "g11": {
                  "==": [
                    {
                      "var": "data.CLS_GOV_G11"
                    },
                    "YES"
                  ]
                }
              },
              "next": "GM_APPROVAL",
              "layout": {
                "x": 340,
                "y": 960
              }
            },
            {
              "code": "GM_APPROVAL",
              "type": "HUMAN_TASK",
              "nameAr": "اعتماد المدير العام",
              "nameEn": "General manager approval",
              "assignment": {
                "target": "ROLE",
                "role": "CLS_GENERAL_MANAGER",
                "mode": "QUEUE"
              },
              "actions": [
                {
                  "code": "APPROVE",
                  "kind": "APPROVE",
                  "nameAr": "اعتماد التصنيف",
                  "nameEn": "Approve the classification",
                  "commentToApplicant": true,
                  "to": "CLASSIFIED"
                },
                {
                  "code": "REJECT",
                  "kind": "REJECT",
                  "nameAr": "رفض الطلب",
                  "nameEn": "Reject the request",
                  "to": "REJECTED"
                },
                {
                  "code": "RETURN",
                  "kind": "RETURN",
                  "nameAr": "طلب بيانات إضافية من مقدم الطلب",
                  "nameEn": "Ask the applicant for additional data"
                }
              ],
              "sla": {
                "byLevel": {
                  "NORMAL": 5,
                  "FAST": 1
                }
              },
              "displayStatus": "PENDING_APPROVAL",
              "layout": {
                "x": 340,
                "y": 1070
              }
            },
            {
              "code": "CLASSIFIED",
              "type": "GATEWAY",
              "nameAr": "هل صُنّف مجال؟",
              "nameEn": "Any domain classified?",
              "routes": [
                {
                  "when": {
                    "var": "decisions.grading.eligible"
                  },
                  "to": "CERTIFICATE"
                }
              ],
              "default": "NOT_CLASSIFIED",
              "layout": {
                "x": 340,
                "y": 1180
              }
            },
            {
              "code": "CERTIFICATE",
              "type": "DOCUMENT",
              "nameAr": "إصدار شهادة التصنيف",
              "nameEn": "Issue the classification certificate",
              "documentType": "CLS_CERTIFICATE",
              "data": {
                "sizeClass": {
                  "var": "decisions.grading.sizeClassNameAr"
                },
                "city": {
                  "var": "data.CLS_CR_CITY"
                },
                "requestNumber": {
                  "var": "number"
                }
              },
              "lines": {
                "source": {
                  "filter": [
                    {
                      "var": "decisions.grading.items"
                    },
                    {
                      "var": "classified"
                    }
                  ]
                },
                "as": "line",
                "fields": {
                  "sectorNameAr": {
                    "var": "line.sectorNameAr"
                  },
                  "sectorNameEn": {
                    "var": "line.sectorNameEn"
                  },
                  "grade": {
                    "var": "line.grade"
                  }
                }
              },
              "reason": "اعتماد طلب التصنيف",
              "next": "APPROVED",
              "layout": {
                "x": 340,
                "y": 1290
              }
            },
            {
              "code": "APPROVED",
              "type": "END",
              "nameAr": "معتمد",
              "nameEn": "Approved",
              "outcome": "APPROVED",
              "layout": {
                "x": 340,
                "y": 1400
              }
            },
            {
              "code": "REJECTED",
              "type": "END",
              "nameAr": "مرفوض",
              "nameEn": "Rejected",
              "outcome": "REJECTED",
              "layout": {
                "x": 600,
                "y": 1510
              }
            },
            {
              "code": "NOT_CLASSIFIED",
              "type": "END",
              "nameAr": "لم يُصنّف أي مجال",
              "nameEn": "No domain classified",
              "outcome": "REJECTED",
              "layout": {
                "x": 600,
                "y": 1620
              }
            },
            {
              "code": "UNPAID",
              "type": "END",
              "nameAr": "إغلاق لعدم السداد",
              "nameEn": "Closed: not paid",
              "outcome": "CLOSED",
              "displayStatus": "CLOSED_UNPAID",
              "layout": {
                "x": 600,
                "y": 1730
              }
            }
          ]
        }
      }
    },
    {
      "entityType": "wf.workflow",
      "entityCode": "CLS_CHANGE",
      "operation": "UPDATE",
      "payload": {
        "nameAr": "معالجة طلبات تعديل الشهادة",
        "nameEn": "Certificate change processing",
        "descriptionAr": "نفس تقييم الإصدار، ثم تعديل الشهادة نفسها بالمجالات والدرجات الجديدة مع بقاء تاريخ الانتهاء.",
        "descriptionEn": "The same evaluation as a new certificate, then the same certificate is amended with the new domains and grades; the expiry stays.",
        "serviceCode": "CLS_CHANGE"
      }
    },
