              ],
              "layout": {
                "x": 600,
                "y": 630
              }
            },
            {
              "code": "FIN_AUDIT",
              "type": "HUMAN_TASK",
              "nameAr": "مراجعة مدير التدقيق",
              "nameEn": "Audit manager review",
              "excludeActorsOf": [
                "FIN_ANALYSIS"
              ],
              "assignment": {
                "target": "ROLE",
                "role": "CLS_AUDIT_MANAGER",
                "mode": "QUEUE"
              },
              "sla": {
                "byLevel": {
                  "NORMAL": 10,
                  "FAST": 1
                },
                "escalateToRole": "CLS_REQUEST_MANAGER"
              },
              "actions": [
                {
                  "code": "CONFIRM",
                  "kind": "COMPLETE",
                  "nameAr": "اعتماد التحليل",
