{
  "title": "NHC — processing workflows",
  "items": [
    {
      "entityType": "wf.workflow",
      "entityCode": "CLS_NEW",
      "operation": "UPDATE",
      "payload": {
        "nameAr": "معالجة طلبات إصدار شهادة التصنيف",
        "nameEn": "New certificate processing",
        "descriptionAr": "مدير طلبات الفرع يراجع ويوزع؛ المسار السريع يسدد الفاتورة؛ ثلاث تقييمات متوازية (الحوكمة، المشاريع والخبرات، المالي) كل منها بمحلل ومدقق؛ احتساب الدرجات؛ اعتماد المدير العام؛ إصدار الشهادة.",
        "descriptionEn": "The branch requests manager reviews and assigns; the fast track pays its invoice; three parallel evaluations (governance, projects & experience, financial), each with an analyst and an auditor; grading; the general manager approves; the certificate is issued.",
        "serviceCode": "CLS_NEW"
      }
    },
    {
      "entityType": "wf.workflow-version",
      "entityCode": "CLS_NEW/2",
      "operation": "CREATE",
      "payload": {
        "nameAr": "الإصدار 2",
        "nameEn": "Version 2",
        "definition": {
          "nodes": [
            {
              "code": "START",
              "type": "START",
              "nameAr": "تقديم الطلب",
              "nameEn": "Submitted",
              "next": "DISTRIBUTE",
              "layout": {
                "x": 340,
                "y": 80
              }
            },
            {
              "code": "DISTRIBUTE",
              "type": "HUMAN_TASK",
              "nameAr": "مراجعة الطلب وتوزيعه على المحللين",
              "nameEn": "Review and assign analysts",
              "assignment": {
                "target": "ROLE",
                "role": "CLS_REQUEST_MANAGER",
                "mode": "QUEUE"
              },
              "actions": [
                {
                  "code": "DISTRIBUTE",
                  "kind": "COMPLETE",
                  "nameAr": "إحالة للتقييم",
                  "nameEn": "Send for evaluation",
                  "to": "TRACK"
                },
                {
                  "code": "RETURN",
                  "kind": "RETURN",
                  "nameAr": "طلب بيانات إضافية من مقدم الطلب",
                  "nameEn": "Ask the applicant for additional data"
                },
                {
                  "code": "REJECT",
                  "kind": "REJECT",
                  "nameAr": "رفض الطلب",
                  "nameEn": "Reject the request",
                  "to": "REJECTED"
                }
              ],
              "sla": {
                "byLevel": {
                  "NORMAL": 3,
                  "FAST": 1
                }
              },
              "layout": {
                "x": 340,
                "y": 190
              }
            },
            {
              "code": "TRACK",
              "type": "GATEWAY",
              "nameAr": "المسار السريع؟",
              "nameEn": "Fast track?",
              "routes": [
                {
                  "when": {
                    "==": [
                      {
                        "var": "level"
                      },
                      "FAST"
                    ]
                  },
                  "to": "PAY"
                }
              ],
              "default": "SPLIT",
              "layout": {
                "x": 340,
                "y": 300
              }
            },
            {
              "code": "PAY",
              "type": "PAYMENT",
              "nameAr": "فاتورة المسار السريع وسدادها",
              "nameEn": "Fast track invoice and payment",
              "provider": "SADAD",
              "displayStatus": "AWAITING_PAYMENT",
              "next": "SPLIT",
              "expired": "UNPAID",
              "layout": {
                "x": 340,
                "y": 410
              }
            },
            {
              "code": "SPLIT",
              "type": "PARALLEL_SPLIT",
              "nameAr": "التقييم المتوازي",
              "nameEn": "Parallel evaluation",
              "branches": [
                "GOV_ANALYSIS",
                "PROJECTS_ANALYSIS",
                "FIN_ANALYSIS"
              ],
              "layout": {
                "x": 340,
                "y": 520
              }
            },
            {
              "code": "GOV_ANALYSIS",
              "type": "HUMAN_TASK",
              "nameAr": "تحليل الحوكمة",
              "nameEn": "Governance analysis",
              "assignment": {
                "target": "PREVIOUS_ACTOR",
                "step": "GOV_ANALYSIS",
                "role": "CLS_GOV_ANALYST",
                "mode": "DISTRIBUTE",
                "distributorRole": "CLS_REQUEST_MANAGER"
              },
              "sla": {
                "byLevel": {
                  "NORMAL": 30,
                  "FAST": 2
                },
                "escalateToRole": "CLS_REQUEST_MANAGER"
              },
              "actions": [
                {
                  "code": "SEND_TO_AUDIT",
                  "kind": "COMPLETE",
                  "nameAr": "رفع للتدقيق",
                  "nameEn": "Send for audit",
                  "to": "GOV_AUDIT"
                },
                {
                  "code": "RETURN",
                  "kind": "RETURN",
                  "nameAr": "طلب بيانات إضافية من مقدم الطلب",
                  "nameEn": "Ask the applicant for additional data"
                }
              ],
              "layout": {
                "x": 80,
                "y": 630
              }
            },
            {
              "code": "GOV_AUDIT",
              "type": "HUMAN_TASK",
              "nameAr": "تدقيق الحوكمة",
              "nameEn": "Governance audit",
              "excludeActorsOf": [
                "GOV_ANALYSIS"
              ],
              "assignment": {
                "target": "ROLE",
                "role": "CLS_GOV_AUDITOR",
                "mode": "QUEUE"
              },
              "sla": {
                "byLevel": {
                  "NORMAL": 10,
                  "FAST": 1
                },
                "escalateToRole": "CLS_REQUEST_MANAGER"
              },
              "actions": [
                {
                  "code": "CONFIRM",
                  "kind": "COMPLETE",
                  "nameAr": "اعتماد التحليل",
                  "nameEn": "Confirm the analysis",
                  "to": "JOIN"
                },
                {
                  "code": "BACK_TO_ANALYST",
                  "kind": "COMPLETE",
                  "nameAr": "إعادة للمحلل",
                  "nameEn": "Back to the analyst",
