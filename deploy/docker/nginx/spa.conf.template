# Rendered by the Nginx image's envsubst step: ${API_UPSTREAM}, ${APP_CODE} and ${AUTH_*} are replaced.
# AUTH_STORAGE is session (default) or local (the field app keeps its session across restarts for offline work).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    server_tokens off;
    client_max_body_size 50m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /health/ {
        proxy_pass ${API_UPSTREAM};
    }

    # Runtime configuration of the SPA (one image for every environment).
    location = /config.json {
        default_type application/json;
        expires -1;
        return 200 '{"app":"${APP_CODE}","auth":{"authority":"${AUTH_AUTHORITY}","clientId":"${AUTH_CLIENT_ID}","scope":"openid profile email","required":${AUTH_REQUIRED},"storage":"${AUTH_STORAGE}"}}';
    }

    # The field app's service worker and manifest are checked for updates on every start.
    location ~ ^/(?:sw\.js|manifest\.webmanifest)$ {
        expires -1;
        try_files $uri =404;
    }

    # Hashed bundles can be cached for a long time; index.html never.
    # (Use `expires`, not `add_header`, here: a location-level add_header would drop the security headers above.)
    location ~* \.(?:js|css|woff2?|ttf|svg|png|ico)$ {
        expires 1y;
        try_files $uri =404;
    }

    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
