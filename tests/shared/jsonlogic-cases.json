[
  { "name": "var: simple", "rule": { "var": "a" }, "data": { "a": 1 }, "result": 1 },
  { "name": "var: nested path", "rule": { "var": "a.b" }, "data": { "a": { "b": "x" } }, "result": "x" },
  { "name": "var: default when missing", "rule": { "var": ["z", 26] }, "data": { "a": 1 }, "result": 26 },
  { "name": "var: array index", "rule": { "var": 1 }, "data": ["apple", "banana"], "result": "banana" },
  { "name": "var: empty path returns data", "rule": { "var": "" }, "data": { "a": 1 }, "result": { "a": 1 } },
  { "name": "var: missing without default", "rule": { "var": "x" }, "data": {}, "result": null },
  { "name": "var: explicit null is not replaced by default", "rule": { "var": ["a", "d"] }, "data": { "a": null }, "result": null },
  { "name": "var: null mid-path uses default", "rule": { "var": ["a.b", "d"] }, "data": { "a": null }, "result": "d" },
  { "name": "var: index inside path", "rule": { "var": "items.1.name" }, "data": { "items": [{ "name": "a" }, { "name": "b" }] }, "result": "b" },

  { "name": "==: number and string", "rule": { "==": [1, "1"] }, "data": null, "result": true },
  { "name": "==: zero and false", "rule": { "==": [0, false] }, "data": null, "result": true },
  { "name": "==: null and zero", "rule": { "==": [null, 0] }, "data": null, "result": false },
  { "name": "==: Arabic text", "rule": { "==": [{ "var": "status" }, "مسودة"] }, "data": { "status": "مسودة" }, "result": true },
  { "name": "===: number and string", "rule": { "===": [1, "1"] }, "data": null, "result": false },
  { "name": "===: integer and decimal", "rule": { "===": [1, 1.0] }, "data": null, "result": true },
  { "name": "!=", "rule": { "!=": [1, 2] }, "data": null, "result": true },
  { "name": "!==", "rule": { "!==": [1, "1"] }, "data": null, "result": true },

  { "name": ">: numbers", "rule": { ">": [2, 1] }, "data": null, "result": true },
  { "name": ">: two strings compare as text", "rule": { ">": ["10", "9"] }, "data": null, "result": false },
  { "name": "<: mixed compares as numbers", "rule": { "<": [1, "2"] }, "data": null, "result": true },
  { "name": "<: between exclusive", "rule": { "<": [1, 2, 3] }, "data": null, "result": true },
  { "name": "<: between exclusive at edge", "rule": { "<": [1, 1, 3] }, "data": null, "result": false },
  { "name": "<=: between inclusive", "rule": { "<=": [1, 1, 3] }, "data": null, "result": true },
  { "name": ">=", "rule": { ">=": [{ "var": "age" }, 18] }, "data": { "age": 18 }, "result": true },

  { "name": "!: array argument", "rule": { "!": [true] }, "data": null, "result": false },
  { "name": "!: bare argument", "rule": { "!": true }, "data": null, "result": false },
  { "name": "!: empty array is falsy", "rule": { "!": [[]] }, "data": null, "result": true },
  { "name": "!!: string zero is truthy", "rule": { "!!": ["0"] }, "data": null, "result": true },
  { "name": "!!: zero is falsy", "rule": { "!!": [0] }, "data": null, "result": false },

  { "name": "or: returns first truthy value", "rule": { "or": [false, "a"] }, "data": null, "result": "a" },
  { "name": "or: returns last value when none truthy", "rule": { "or": [0, ""] }, "data": null, "result": "" },
  { "name": "and: returns last value when all truthy", "rule": { "and": [true, "a", 3] }, "data": null, "result": 3 },
  { "name": "and: returns first falsy value", "rule": { "and": [true, "", 3] }, "data": null, "result": "" },
  { "name": "and/in: eligibility style rule", "rule": { "and": [{ ">=": [{ "var": "age" }, 18] }, { "in": [{ "var": "region" }, ["RYD", "JED"]] }] }, "data": { "age": 20, "region": "JED" }, "result": true },

  { "name": "if: then/else", "rule": { "if": [true, "yes", "no"] }, "data": null, "result": "yes" },
  { "name": "if: chain", "rule": { "if": [{ "<": [{ "var": "t" }, 0] }, "freezing", { "<": [{ "var": "t" }, 100] }, "liquid", "gas"] }, "data": { "t": 55 }, "result": "liquid" },
  { "name": "if: single argument", "rule": { "if": ["x"] }, "data": null, "result": "x" },
  { "name": "if: no arguments", "rule": { "if": [] }, "data": null, "result": null },
  { "name": "if: empty array condition is falsy", "rule": { "if": [[], "t", "f"] }, "data": null, "result": "f" },
  { "name": "if: non-empty array condition is truthy", "rule": { "if": [[0], "t", "f"] }, "data": null, "result": "t" },
  { "name": "?: alias", "rule": { "?:": [false, 1, 2] }, "data": null, "result": 2 },

  { "name": "+: coerces strings", "rule": { "+": [1, "2", 3] }, "data": null, "result": 6 },
  { "name": "+: no arguments", "rule": { "+": [] }, "data": null, "result": 0 },
  { "name": "+: parseFloat prefix", "rule": { "+": ["3.5abc"] }, "data": null, "result": 3.5 },
  { "name": "+: NaN becomes null", "rule": { "+": ["abc"] }, "data": null, "result": null },
  { "name": "*", "rule": { "*": [2, "3"] }, "data": null, "result": 6 },
  { "name": "-: binary", "rule": { "-": [5, 2] }, "data": null, "result": 3 },
  { "name": "-: unary", "rule": { "-": [2] }, "data": null, "result": -2 },
  { "name": "/", "rule": { "/": [4, 2] }, "data": null, "result": 2 },
  { "name": "%", "rule": { "%": [101, 2] }, "data": null, "result": 1 },
  { "name": "max", "rule": { "max": [1, 3, 2] }, "data": null, "result": 3 },
  { "name": "min", "rule": { "min": [1, 3, 2] }, "data": null, "result": 1 },

  { "name": "cat: strings", "rule": { "cat": ["I love ", "pie"] }, "data": null, "result": "I love pie" },
  { "name": "cat: mixed values, null is empty", "rule": { "cat": ["a", 1, true, null] }, "data": null, "result": "a1true" },
  { "name": "cat: decimals", "rule": { "cat": [1.5, " ", 2] }, "data": null, "result": "1.5 2" },
  { "name": "substr: start", "rule": { "substr": ["jsonlogic", 4] }, "data": null, "result": "logic" },
  { "name": "substr: negative start", "rule": { "substr": ["jsonlogic", -5] }, "data": null, "result": "logic" },
  { "name": "substr: length", "rule": { "substr": ["jsonlogic", 1, 3] }, "data": null, "result": "son" },
  { "name": "substr: negative length", "rule": { "substr": ["jsonlogic", 4, -2] }, "data": null, "result": "log" },
  { "name": "in: substring", "rule": { "in": ["Spring", "Springfield"] }, "data": null, "result": true },
  { "name": "in: array member", "rule": { "in": ["Ringo", ["John", "Paul", "George", "Ringo"]] }, "data": null, "result": true },
  { "name": "in: array uses strict equality", "rule": { "in": [1, ["1"]] }, "data": null, "result": false },
  { "name": "merge: arrays", "rule": { "merge": [[1, 2], [3, 4]] }, "data": null, "result": [1, 2, 3, 4] },
  { "name": "merge: values and arrays", "rule": { "merge": [1, 2, [3, 4]] }, "data": null, "result": [1, 2, 3, 4] },

  { "name": "missing", "rule": { "missing": ["a", "b"] }, "data": { "a": "apple", "c": "carrot" }, "result": ["b"] },
  { "name": "missing: empty string counts as missing", "rule": { "missing": ["a", "b"] }, "data": { "a": "", "b": 1 }, "result": ["a"] },
  { "name": "missing: with merge", "rule": { "missing": { "merge": ["vin", { "if": [{ "var": "financing" }, ["apr", "term"], []] }] } }, "data": { "financing": true }, "result": ["vin", "apr", "term"] },
  { "name": "missing_some: satisfied", "rule": { "missing_some": [1, ["a", "b", "c"]] }, "data": { "a": "apple" }, "result": [] },
  { "name": "missing_some: not satisfied", "rule": { "missing_some": [2, ["a", "b", "c"]] }, "data": { "a": "apple" }, "result": ["b", "c"] },

  { "name": "map", "rule": { "map": [{ "var": "integers" }, { "*": [{ "var": "" }, 2] }] }, "data": { "integers": [1, 2, 3] }, "result": [2, 4, 6] },
  { "name": "filter", "rule": { "filter": [{ "var": "integers" }, { "%": [{ "var": "" }, 2] }] }, "data": { "integers": [1, 2, 3] }, "result": [1, 3] },
  { "name": "reduce", "rule": { "reduce": [{ "var": "integers" }, { "+": [{ "var": "current" }, { "var": "accumulator" }] }, 0] }, "data": { "integers": [1, 2, 3] }, "result": 6 },
  { "name": "all: true", "rule": { "all": [[1, 2, 3], { ">": [{ "var": "" }, 0] }] }, "data": null, "result": true },
  { "name": "all: empty is false", "rule": { "all": [[], { ">": [{ "var": "" }, 0] }] }, "data": null, "result": false },
  { "name": "none", "rule": { "none": [[-3, -2], { ">": [{ "var": "" }, 0] }] }, "data": null, "result": true },
  { "name": "some", "rule": { "some": [{ "var": "pies" }, { "==": [{ "var": "filling" }, "apple"] }] }, "data": { "pies": [{ "filling": "pumpkin" }, { "filling": "apple" }] }, "result": true },

  { "name": "object with two keys is data, not a rule", "rule": { "a": 1, "b": 2 }, "data": null, "result": { "a": 1, "b": 2 } },
  { "name": "array literal is evaluated element-wise", "rule": [{ "var": "a" }, 2], "data": { "a": 1 }, "result": [1, 2] },
  { "name": "number literal", "rule": 5, "data": null, "result": 5 },
  { "name": "string literal", "rule": "x", "data": null, "result": "x" },
  { "name": "null literal", "rule": null, "data": null, "result": null }
]
