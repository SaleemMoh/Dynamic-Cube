<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>DynamicCube.Migrator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\Hosting\DynamicCube.Hosting.csproj" />
    <ProjectReference Include="..\..\Modules\AppsControl\DynamicCube.Modules.AppsControl.csproj" />
    <ProjectReference Include="..\..\Modules\Integration\DynamicCube.Modules.Integration.csproj" />
    <ProjectReference Include="..\..\Modules\Parties\DynamicCube.Modules.Parties.csproj" />
    <ProjectReference Include="..\..\Modules\Services\DynamicCube.Modules.Services.csproj" />
    <ProjectReference Include="..\..\Modules\Communication\DynamicCube.Modules.Communication.csproj" />
    <ProjectReference Include="..\..\Modules\Payments\DynamicCube.Modules.Payments.csproj" />
    <ProjectReference Include="..\..\Modules\Visits\DynamicCube.Modules.Visits.csproj" />
    <ProjectReference Include="..\..\Modules\Content\DynamicCube.Modules.Content.csproj" />
    <ProjectReference Include="..\..\Modules\Decisions\DynamicCube.Modules.Decisions.csproj" />
    <ProjectReference Include="..\..\Modules\Documents\DynamicCube.Modules.Documents.csproj" />
    <ProjectReference Include="..\..\Modules\Workflow\DynamicCube.Modules.Workflow.csproj" />
