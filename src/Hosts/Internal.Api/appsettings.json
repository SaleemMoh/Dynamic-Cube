{
  "ConnectionStrings": {
    "DynamicCube": ""
  },
  "Authentication": {
    "Internal": {
      "Authority": "",
      "Audience": "dynamic-cube-internal-api",
      "ConnectAudience": "dynamic-cube-connect-api",
      "RequireHttpsMetadata": true
    }
  },
  "PublicApi": {
    "Audience": "dynamic-cube-public-api",
    "BaseUrl": "",
    "TokenUrl": ""
  },
  "FileStorage": {
    "RootPath": "storage"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ChangeSets": {
    "RequireApprovalByDefault": true
  },
  "AppsControl": {
    "BootstrapUsers": {},
    "LovSqlConnectionString": "",
    "AccessCacheSeconds": 60
  }
}
