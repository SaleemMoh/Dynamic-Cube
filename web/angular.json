{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "internal": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/internal",
      "sourceRoot": "projects/internal/src",
      "prefix": "dc",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/internal/src/main.ts",
            "tsConfig": "projects/internal/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/internal/public"
              },
              {
                "glob": "**/*",
                "input": "projects/shared/src/assets",
                "output": "dc"
              }
            ],
            "styles": [
              "node_modules/@fontsource/ibm-plex-sans-arabic/400.css",
              "node_modules/@fontsource/ibm-plex-sans-arabic/500.css",
              "node_modules/@fontsource/ibm-plex-sans-arabic/600.css",
              "node_modules/material-symbols/outlined.css",
              "projects/shared/src/styles/dc-base.scss",
              "projects/shared/src/styles/dc-dga.scss",
              "projects/internal/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "internal:build:production"
            },
            "development": {
              "buildTarget": "internal:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "projects/internal/proxy.conf.json"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/internal/**/*.ts",
              "projects/internal/**/*.html"
            ],
            "eslintConfig": "projects/internal/eslint.config.js"
          }
        }
      }
    },
    "external": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/external",
      "sourceRoot": "projects/external/src",
      "prefix": "dc",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/external/src/main.ts",
            "tsConfig": "projects/external/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/external/public"
              },
              {
                "glob": "**/*",
                "input": "projects/shared/src/assets",
                "output": "dc"
              }
            ],
            "styles": [
              "node_modules/@fontsource/ibm-plex-sans-arabic/400.css",
              "node_modules/@fontsource/ibm-plex-sans-arabic/500.css",
              "node_modules/@fontsource/ibm-plex-sans-arabic/600.css",
              "node_modules/material-symbols/outlined.css",
              "projects/shared/src/styles/dc-base.scss",
              "projects/shared/src/styles/dc-dga.scss",
              "projects/external/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "external:build:production"
            },
            "development": {
              "buildTarget": "external:build:development"
            }
          },
          "defaultConfiguration": "development",
          "options": {
            "proxyConfig": "projects/external/proxy.conf.json"
          }
        },
        "test": {
