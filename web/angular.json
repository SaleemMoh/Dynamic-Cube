          }
        }
      }
    },
    "field": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/field",
      "sourceRoot": "projects/field/src",
      "prefix": "dc",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/field/src/main.ts",
            "tsConfig": "projects/field/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
